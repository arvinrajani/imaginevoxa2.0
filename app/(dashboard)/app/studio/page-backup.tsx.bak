const parseList = (value: string) =>
  value
    .split(',')
    .map((item) => item.trim())
    .filter(Boolean);

const listToString = (value?: string[] | null) => (Array.isArray(value) ? value.join(', ') : '');
const listFromString = (value: string) => parseList(value || '');
const selectedValuesFromEvent = (event: ChangeEvent<HTMLSelectElement>) =>
  Array.from(event.target.selectedOptions).map((option) => option.value);
const formatOptionLabel = (value: string) => value.replace(/[-_]/g, ' ');
const createTemplateId = () =>
  typeof crypto !== 'undefined' && 'randomUUID' in crypto ? crypto.randomUUID() : `${Date.now()}`;
const templateThumbnail = (colors: string[]) => {
  const palette = colors.filter(Boolean);
  const [primary, secondary, accent] = [
    palette[0] || '#0A66C2',
    palette[1] || '#0F172A',
    palette[2] || '#22D3EE',
  ];
  const svg = `
<svg xmlns="http://www.w3.org/2000/svg" width="240" height="140" viewBox="0 0 240 140">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="${primary}" stop-opacity="0.9" />
      <stop offset="100%" stop-color="${secondary}" stop-opacity="0.9" />
    </linearGradient>
  </defs>
  <rect width="240" height="140" rx="16" fill="url(#bg)" />
  <rect x="16" y="18" width="120" height="14" rx="7" fill="${accent}" />
  <rect x="16" y="44" width="190" height="10" rx="5" fill="rgba(255,255,255,0.6)" />
  <rect x="16" y="64" width="160" height="10" rx="5" fill="rgba(255,255,255,0.5)" />
  <rect x="16" y="94" width="90" height="10" rx="5" fill="rgba(255,255,255,0.45)" />
  <circle cx="200" cy="34" r="12" fill="rgba(255,255,255,0.6)" />
</svg>
  `.trim();
  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
};

