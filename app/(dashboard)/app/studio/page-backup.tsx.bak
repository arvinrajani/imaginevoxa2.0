    const data = await res.json();
    setBrandKits((prev) => [data.brand_kit, ...prev]);
    setBrandKitId(data.brand_kit.id);
  };

  const analyzeLinkedIn = async (textOverride?: string) => {
    const sourceText = textOverride ?? analysisText;
    if (!brandId) {
      setBrandError('Select a brand before analyzing posts.');
      return;
    }
    if (!sourceText.trim()) return;
    const posts = sourceText
      .split(/\n{2,}/)
      .map((block) => block.trim())
      .filter(Boolean)
      .map((text) => ({ text }));
    if (posts.length < 3) return;
    setIsBusy(true);
    const res = await fetch('/api/pro/linkedin/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ brandId, posts }),
    });
    setIsBusy(false);
    if (res.ok) {
      const data = await res.json();
      setAnalysisResult(data.profile);
    }
  };

  const fetchLinkedInPosts = async () => {
    if (!brandId) {
      setBrandError('Select a brand before fetching posts.');
      return;
    }
    setIsBusy(true);
    const res = await fetch('/api/pro/linkedin/fetch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ brandId, limit: 20 }),
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data.posts)) {
        const joined = (data.posts as Array<{ text: string }>).map((post) => post.text).join('\n\n');
        setAnalysisText(joined);
        await analyzeLinkedIn(joined);
      }
    }
    setIsBusy(false);
  };

