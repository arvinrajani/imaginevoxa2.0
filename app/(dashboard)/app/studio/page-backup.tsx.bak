  const assignCampaign = async () => {
    if (!postId) {
      setCampaignError('Generate a post before assigning a campaign.');
      return;
    }
    if (!campaignId) {
      setCampaignError('Select a campaign before assigning.');
      return;
    }
    setIsBusy(true);
    await supabase.from('campaign_posts').delete().eq('post_id', postId);
    const { error } = await supabase.from('campaign_posts').insert({
      campaign_id: campaignId,
      post_id: postId,
    });
    setIsBusy(false);
    if (error) {
      setCampaignError(error.message || 'Failed to assign campaign.');
      return;
    }
    setCampaignId(campaignId);
    setCampaignError(null);
  };

  const saveSchedule = async () => {
    if (!postId) {
      setCampaignError('Generate a post before scheduling.');
      return;
    }
    setIsBusy(true);
