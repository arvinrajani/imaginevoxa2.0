type Brand = { id: string; name: string; owner_user_id: string };
type BrandKit = {
  id: string;
  name: string;
  is_locked: boolean;
  logo_assets?: Array<{ url?: string; asset_id?: string; name?: string }>;
};
type MoodBoard = { id: string; name: string; is_locked: boolean };
type ImageProfile = { id: string; name: string; category?: string | null };
type LayoutZone = {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  align?: 'left' | 'center' | 'right';
  padding?: number;
};

type PostOption = {
  headline: string;
  hook?: string;
  body: string;
  cta: string;
  hashtags?: string[];
  risk_flags?: string[];
  notes?: string;
  selected?: boolean;
};

type ComplianceCheck = {
  type: string;
  status: string;
  score?: number | null;
};

type ComplianceResult = {
  status: string;
  checks: ComplianceCheck[];
};

type AnalysisResult = {
  tone: string;
  image_style: string;
  cta_style: string;
  visual_density: string;
  product_mentions?: string[];
  content_pillars?: string[];
};

type ContentSource = {
  id: string;
  source_url: string;
  title?: string | null;
  content_excerpt?: string | null;
  source_type?: string | null;
};

type Campaign = {
  id: string;
  name: string;
  description?: string | null;
  status?: string | null;
  starts_at?: string | null;
  ends_at?: string | null;
};

type MarketingIdentity = {
  id: string;
  voice_traits?: string[] | null;
  positioning?: string | null;
  audience_personas?: string[] | null;
  do_not_use?: string[] | null;
  preferred_phrases?: string[] | null;
