  const [maskTool, setMaskTool] = useState<'brush' | 'rect' | 'circle' | 'line'>('brush');
  const [styleReferenceUrl, setStyleReferenceUrl] = useState('');
  const [styleSummary, setStyleSummary] = useState<string | null>(null);
  const [stylePalette, setStylePalette] = useState<string[]>([]);
  const [styleError, setStyleError] = useState<string | null>(null);
  const [isStyleLoading, setIsStyleLoading] = useState(false);
  const [uploadBaseFile, setUploadBaseFile] = useState<File | null>(null);
  const [uploadBaseError, setUploadBaseError] = useState<string | null>(null);
  const [uploadRefFile, setUploadRefFile] = useState<File | null>(null);
  const [layoutProfileName, setLayoutProfileName] = useState('');
  const [imagePresetName, setImagePresetName] = useState('');
  const [imagePresets, setImagePresets] = useState<Array<{ id: string; name: string; settings: Record<string, unknown> }>>([]);

  const [textBlocks, setTextBlocks] = useState({
    label: 'ANNOUNCEMENT',
    title: '',
    meta: '',
    cta: '',
  });
  const [textStyles, setTextStyles] = useState<Record<string, { color?: string; fontSize?: number }>>({
    label: { color: '#22D3EE', fontSize: 28 },
    title: { color: '#FFFFFF', fontSize: 58 },
    meta: { color: '#E2E8F0', fontSize: 30 },
    cta: { color: '#FFFFFF', fontSize: 28 },
  });
  const [composedUrl, setComposedUrl] = useState<string | null>(null);
  const previewRef = useRef<HTMLDivElement | null>(null);
  const maskCanvasRef = useRef<HTMLCanvasElement | null>(null);
  const isDrawingRef = useRef(false);
  const lastPointRef = useRef<{ x: number; y: number } | null>(null);
  const shapeStartRef = useRef<{ x: number; y: number } | null>(null);

  const [compliance, setCompliance] = useState<ComplianceResult | null>(null);
  const [analysisText, setAnalysisText] = useState('');
  const [analysisResult, setAnalysisResult] = useState<AnalysisResult | null>(null);
  const [isBusy, setIsBusy] = useState(false);
  const [brandError, setBrandError] = useState<string | null>(null);
  const [brandKitError, setBrandKitError] = useState<string | null>(null);
  const [moodError, setMoodError] = useState<string | null>(null);
  const [profileError, setProfileError] = useState<string | null>(null);
  const [copyError, setCopyError] = useState<string | null>(null);
  const [imageError, setImageError] = useState<string | null>(null);
  const [campaignError, setCampaignError] = useState<string | null>(null);
  const [publishError, setPublishError] = useState<string | null>(null);

  const activeBrand = brands.find((brand) => brand.id === brandId) || null;
  const activeBrandKit = brandKits.find((kit) => kit.id === brandKitId) || null;
  const activeMoodBoard = moodBoards.find((mood) => mood.id === moodBoardId) || null;
  const activeProfile = imageProfiles.find((profile) => profile.id === imageProfileId) || null;
  const activeCampaign = campaigns.find((campaign) => campaign.id === campaignId) || null;

  const selectedOption = useMemo(
    () => postOptions.find((option) => option.selected) || null,
    [postOptions]
  );

  const postPreview = useMemo(() => {
    if (!selectedOption) return '';
    const parts = [
      selectedOption.hook?.trim(),
      selectedOption.body?.trim(),
      selectedOption.cta?.trim(),
      selectedOption.hashtags?.length ? selectedOption.hashtags.join(' ') : null,
    ].filter(Boolean);
    return parts.join('\n\n');
  }, [selectedOption]);

  const batchSchedulePreview = useMemo(() => {
    if (!batchScheduleStart || !batchRuns.length) return [];
    const startDate = new Date(batchScheduleStart);
    if (Number.isNaN(startDate.getTime())) return [];
    return batchRuns.map((run, index) => ({
      id: run.id,
      prompt: run.prompt,
      scheduledFor: new Date(startDate.getTime() + index * batchScheduleIntervalDays * 24 * 60 * 60 * 1000),
      scheduledForLabel: new Date(
        startDate.getTime() + index * batchScheduleIntervalDays * 24 * 60 * 60 * 1000
      ).toISOString(),
    }));
  }, [batchRuns, batchScheduleIntervalDays, batchScheduleStart]);

  const livePreviewHeadline = useMemo(() => {
    if (selectedOption?.headline) return selectedOption.headline;
    if (!postPrompt) return 'Your headline will appear here';
    return postPrompt.split('\n')[0]?.slice(0, 80) || 'Your headline will appear here';
  }, [postPrompt, selectedOption]);

  const livePreviewBody = useMemo(() => {
    if (selectedOption?.hook) return selectedOption.hook;
    if (selectedOption?.body) return selectedOption.body.slice(0, 120);
    if (!postPrompt) return 'Add a prompt to preview the copy.';
    return postPrompt.slice(0, 140);
  }, [postPrompt, selectedOption]);

  const studioSteps = useMemo(
    () => [
      {
        id: 'brand',
        title: 'Brand',
        done: Boolean(brandId),
        detail: activeBrand ? `Active: ${activeBrand.name}` : 'Create a brand workspace.',
        tab: 'brand',
      },
      {
        id: 'identity',
        title: 'Marketing identity',
        done: Boolean(identityId),
        detail: identityId
          ? identityLocked
            ? 'Locked'
            : 'Draft saved'
          : 'Define voice traits and audience.',
        tab: 'brand',
      },
      {
        id: 'kit',
        title: 'Brand kit',
        done: Boolean(brandKitId),
        detail: activeBrandKit ? activeBrandKit.name : 'Create or suggest a kit.',
        tab: 'brand',
      },
      {
        id: 'mood',
        title: 'Mood board',
        done: Boolean(moodBoardId),
        detail: activeMoodBoard ? activeMoodBoard.name : 'Define the visual mood.',
        tab: 'mood',
      },
      {
        id: 'profiles',
        title: 'Image profile',
        done: Boolean(imageProfileId),
        detail: activeProfile ? activeProfile.name : 'Seed or pick a layout.',
        tab: 'profiles',
      },
      {
        id: 'sources',
        title: 'Sources',
        done: sources.length > 0,
        detail: sources.length > 0 ? `${sources.length} saved` : 'Add URLs for grounding.',
        tab: 'copy',
      },
      {
        id: 'copy',
        title: 'Copy options',
        done: postOptions.length > 0,
        detail: postOptions.length > 0 ? `${postOptions.length} options` : 'Generate options.',
        tab: 'copy',
      },
      {
        id: 'selection',
        title: 'Option selected',
        done: Boolean(selectedOption),
        detail: selectedOption?.headline || 'Pick the strongest option.',
        tab: 'copy',
      },
      {
        id: 'campaign',
        title: 'Campaign',
        done: Boolean(campaignId),
        detail: activeCampaign ? activeCampaign.name : 'Optional grouping.',
        tab: 'publish',
        optional: true,
      },
      {
        id: 'schedule',
        title: 'Schedule',
        done: Boolean(scheduleAt),
        detail: scheduleAt ? `Scheduled for ${scheduleAt}` : 'Optional scheduling.',
        tab: 'publish',
        optional: true,
      },
      {
        id: 'image',
        title: 'Base image',
        done: Boolean(baseImageUrl),
        detail: baseImageUrl ? 'Generated' : 'Create a base visual.',
        tab: 'image',
      },
      {
        id: 'compose',
        title: 'Composed image',
        done: Boolean(composedUrl),
        detail: composedUrl ? 'Composed' : 'Add branded typography.',
        tab: 'image',
      },
      {
        id: 'compliance',
        title: 'Compliance',
        done: Boolean(compliance),
        detail: compliance ? `Status: ${compliance.status}` : 'Run checks.',
        tab: 'publish',
      },
    ],
    [
      activeBrand,
      activeBrandKit,
      activeMoodBoard,
      activeProfile,
      baseImageUrl,
      brandId,
      brandKitId,
      compliance,
      composedUrl,
      identityId,
      identityLocked,
      imageProfileId,
      activeCampaign,
      campaignId,
      scheduleAt,
      moodBoardId,
      postOptions.length,
      selectedOption,
      sources.length,
    ]
  );

  const wizardSteps = useMemo(
    () => [
      { id: 'overview', title: 'Overview', description: 'Check readiness and run quick setup.', tab: 'overview' },
      { id: 'brand', title: 'Brand Kit', description: 'Set colors, tone, and logos.', tab: 'brand' },
      { id: 'mood', title: 'Mood Board', description: 'Pick visual direction.', tab: 'mood' },
      { id: 'profiles', title: 'Image Profiles', description: 'Choose layout templates.', tab: 'profiles' },
      { id: 'copy', title: 'Copy', description: 'Generate and select post copy.', tab: 'copy' },
      { id: 'image', title: 'Image', description: 'Generate and compose branded images.', tab: 'image' },
      { id: 'publish', title: 'Publish', description: 'Run compliance and schedule.', tab: 'publish' },
    ],
    []
  );

  const requiredSteps = studioSteps.filter((step) => !step.optional);
  const studioProgress = Math.round(
    (requiredSteps.filter((step) => step.done).length / requiredSteps.length) * 100
  );

  const headerSubtitle = (
    <span className="flex flex-wrap items-center gap-2">
      <span>Control brand, mood, copy, and visuals. AI proposes — you decide.</span>
      <Badge variant="secondary">
        {activeBrand ? `Brand: ${activeBrand.name}` : 'No brand selected'}
      </Badge>
      <Badge variant="secondary">{studioProgress}% ready</Badge>
    </span>
  );

  const publishIssues = useMemo(() => {
    const issues: string[] = [];
    if (!selectedOption) issues.push('Select a post option before publishing.');
    if (!compliance) issues.push('Run compliance checks before publishing.');
    if (compliance?.status === 'fail') issues.push('Resolve failed compliance checks.');
    if (scheduleAt) {
      const scheduleDate = new Date(scheduleAt);
      if (Number.isNaN(scheduleDate.getTime())) {
        issues.push('Scheduled time is invalid.');
      }
    }
    return issues;
  }, [compliance, selectedOption, scheduleAt]);

  const doNotUseList = useMemo(
    () => parseList(identityForm.do_not_use).map((term) => term.toLowerCase()),
    [identityForm.do_not_use]
  );
  const preferredPhraseList = useMemo(
    () => parseList(identityForm.preferred_phrases),
    [identityForm.preferred_phrases]
  );
  const promptGuardrails = useMemo(() => {
    const text = postPrompt.toLowerCase();
    return doNotUseList.filter((term) => term && text.includes(term));
  }, [doNotUseList, postPrompt]);
  const previewGuardrails = useMemo(() => {
    const text = postPreview.toLowerCase();
    return doNotUseList.filter((term) => term && text.includes(term));
  }, [doNotUseList, postPreview]);
  const missingPreferredPhrases = useMemo(() => {
    if (!postPreview) return [];
    const text = postPreview.toLowerCase();
    return preferredPhraseList.filter((phrase) => phrase && !text.includes(phrase.toLowerCase()));
  }, [postPreview, preferredPhraseList]);

  const layoutPreviewZones = useMemo(() => {
    if (!manualLayout) return DEFAULT_LAYOUT_ZONES;
    if (Object.keys(layoutZones).length === 0) {
      return DEFAULT_LAYOUT_ZONES;
    }
    return DEFAULT_LAYOUT_ZONES.map((zone) => layoutZones[zone.id] || zone);
  }, [layoutZones, manualLayout]);

  const layoutOverride = useMemo(() => {
    if (!manualLayout) return null;
    const zones = layoutPreviewZones.map((zone) => ({
      id: zone.id,
      x: zone.x,
      y: zone.y,
      w: zone.w,
      h: zone.h,
      align: zone.align,
      padding: zone.padding,
    }));
    return { width: 1200, height: 628, zones, logoZoneId: 'logo' };
  }, [layoutPreviewZones, manualLayout]);

  const styleAddon = useMemo(() => {
    const parts: string[] = [];
    if (styleSummary) {
      parts.push(`Style notes: ${styleSummary}`);
    }
    if (stylePalette.length) {
      parts.push(`Palette: ${stylePalette.join(', ')}`);
    }
    if (!parts.length) return '';
    return parts.join('\n');
  }, [stylePalette, styleSummary]);

  const buildImagePrompt = (prompt: string) => (styleAddon ? `${prompt}\n${styleAddon}` : prompt);

  useEffect(() => {
    const load = async () => {
      const { data } = await supabase.auth.getUser();
      setUserId(data.user?.id ?? null);

      const owned = await supabase.from('brands').select('*').order('created_at', { ascending: false });
      const nextBrands = (owned.data as Brand[]) || [];
      setBrands(nextBrands);
      if (!brandId && nextBrands.length === 1) {
        setBrandId(nextBrands[0].id);
      }
    };
    load();
  }, [brandId, supabase]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const stored = window.localStorage.getItem('studio_templates');
    if (!stored) return;
    try {
      const parsed = JSON.parse(stored) as StudioTemplate[];
      setTemplates(parsed);
    } catch {
      // Ignore invalid stored templates.
    }
  }, []);

  useEffect(() => {
    if (!brandId) return;
    const loadBrandData = async () => {
      const [kits, moods, profiles] = await Promise.all([
        supabase
          .from('brand_kits')
          .select('id,name,is_locked,logo_assets')
          .eq('brand_id', brandId)
          .order('created_at', { ascending: false }),
        supabase.from('mood_boards').select('id,name,is_locked').eq('brand_id', brandId).order('created_at', { ascending: false }),
        supabase.from('image_profiles').select('id,name,category').eq('brand_id', brandId).order('created_at', { ascending: false }),
      ]);
      const nextKits = (kits.data as BrandKit[]) || [];
      const nextMoods = (moods.data as MoodBoard[]) || [];
      const nextProfiles = (profiles.data as ImageProfile[]) || [];
      setBrandKits(nextKits);
      setMoodBoards(nextMoods);
      setImageProfiles(nextProfiles);
      if (!brandKitId && nextKits[0]?.id) {
        setBrandKitId(nextKits[0].id);
      }
      if (!moodBoardId && nextMoods[0]?.id) {
        setMoodBoardId(nextMoods[0].id);
      }
      if (!imageProfileId && nextProfiles[0]?.id) {
        setImageProfileId(nextProfiles[0].id);
      }
    };
    loadBrandData();
  }, [brandId, brandKitId, imageProfileId, moodBoardId, supabase]);

  useEffect(() => {
    if (typeof window === 'undefined' || !brandId) return;
    const stored = window.localStorage.getItem(`image_presets_${brandId}`);
    if (!stored) {
      setImagePresets([]);
      return;
    }
    try {
      const parsed = JSON.parse(stored) as Array<{ id: string; name: string; settings: Record<string, unknown> }>;
      setImagePresets(parsed);
    } catch {
      setImagePresets([]);
    }
  }, [brandId]);

  useEffect(() => {
    if (!brandId) return;

    const loadIdentity = async () => {
      const { data } = await supabase
        .from('marketing_identities')
        .select('*')
        .eq('brand_id', brandId)
        .order('created_at', { ascending: false })
        .limit(1)
        .maybeSingle();

      if (data) {
        const identity = data as MarketingIdentity;
        setIdentityId(identity.id);
        setIdentityLocked(Boolean(identity.is_locked));
        setIdentityForm({
          voice_traits: listToString(identity.voice_traits),
          positioning: identity.positioning || '',
          audience_personas: listToString(identity.audience_personas),
          do_not_use: listToString(identity.do_not_use),
          preferred_phrases: listToString(identity.preferred_phrases),
        });
      }
    };

    loadIdentity();
  }, [brandId, supabase]);

  useEffect(() => {
    if (!brandId) return;
    const loadSources = async () => {
      const { data } = await supabase
        .from('content_sources')
        .select('id,source_url,title,content_excerpt,source_type')
        .eq('brand_id', brandId)
        .order('created_at', { ascending: false })
        .limit(8);
      setSources((data as ContentSource[]) || []);
      setSelectedSourceIds([]);
      setSourceError(null);
    };
    loadSources();
  }, [brandId, supabase]);

  useEffect(() => {
    if (!brandId) return;

    const loadCampaigns = async () => {
      const { data } = await supabase
        .from('campaigns')
        .select('id,name,description,status,starts_at,ends_at')
        .eq('brand_id', brandId)
        .order('created_at', { ascending: false });
      setCampaigns((data as Campaign[]) || []);
    };

    loadCampaigns();
  }, [brandId, supabase]);

  useEffect(() => {
    if (!postId) return;
    const loadCampaignAssignment = async () => {
      const { data } = await supabase
        .from('campaign_posts')
        .select('campaign_id')
        .eq('post_id', postId)
        .order('created_at', { ascending: false })
        .limit(1)
        .maybeSingle();
      if (data?.campaign_id) {
        setCampaignId(data.campaign_id);
      }
    };
    loadCampaignAssignment();
  }, [postId, supabase]);

  useEffect(() => {
    if (!postId) return;
    const loadSchedule = async () => {
      const { data } = await supabase
        .from('posts')
        .select('scheduled_for')
        .eq('id', postId)
        .single();
      if (data?.scheduled_for) {
        setScheduleAt(toLocalDateTimeInput(data.scheduled_for));
      }
    };
    loadSchedule();
  }, [postId, supabase]);

  useEffect(() => {
    if (!maskCanvasRef.current) return;
    const canvas = maskCanvasRef.current;
    const [width, height] = imageSize.split('x').map((value) => Number(value));
    const nextWidth = Number.isFinite(width) ? width : 1200;
    const nextHeight = Number.isFinite(height) ? height : 628;
    canvas.width = nextWidth;
    canvas.height = nextHeight;
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  }, [imageSize, baseImageUrl]);

  const selectBrand = (id: string) => {
    setBrandId(id);
    setBrandError(null);
    setBrandKitError(null);
    setMoodError(null);
    setProfileError(null);
    setCopyError(null);
    setImageError(null);
    setCampaignError(null);
    setPublishError(null);
    setQuickSetupError(null);
    setTemplateError(null);
    setIdentityId(null);
    setIdentityLocked(false);
    setIdentityError(null);
    setIdentityForm({
      voice_traits: '',
      positioning: '',
      audience_personas: '',
      do_not_use: '',
      preferred_phrases: '',
    });
    setCampaigns([]);
    setCampaignId('');
    setCampaignForm({ name: '', description: '', starts_at: '', ends_at: '' });
    setBrandKitId('');
    setPalettePreset('');
    setMoodBoardId('');
    setImageProfileId('');
    setPostPrompt('');
    setPostPromptTemplate('');
    setPostOptions([]);
    setPostId(null);
    setBasePrompt('');
    setImagePromptTemplate('');
    setBaseImageUrl(null);
    setComposedUrl(null);
    setCompliance(null);
    setScheduleAt('');
    setLogoFile(null);
    setLogoError(null);
    setAnalysisText('');
    setAnalysisResult(null);
    setSources([]);
    setSelectedSourceIds([]);
    setSourceError(null);
    setBatchPrompts('');
    setBatchRuns([]);
    setBatchError(null);
    setBatchScheduleStart('');
    setBatchScheduleIntervalDays(2);
    setBatchScheduleError(null);
    setBatchScheduleSuccess(null);
    setAudienceLevel('general');
    setLogoPlacement('top-right');
    setAutoCompose(true);
    setHealthStatus(null);
    setHealthError(null);
    setBrandBrief('');
    setBrandBriefError(null);
    setBrandBriefLoading(false);
    setBrandBriefResult(null);
    setBrandBriefSaving(false);
    setBrandBriefSaveError(null);
    setBrandBriefSaveSuccess(null);
    setWizardOpen(false);
    setWizardStep(0);
    setLogoScale(1);
    setLogoPadding(8);
    setBannerStyle('none');
    setBannerColor('#0F172A');
    setBannerOpacity(0.45);
    setOverlayOpacity(0.12);
    setBaseScale(1);
    setBaseOffsetX(0);
    setBaseOffsetY(0);
    setBrightness(1);
    setContrast(1);
    setSaturation(1);
    setBlur(0);
    setManualLayout(false);
    setLayoutZones({});
    setDraggingZone(null);
    setCustomBaseUrl('');
    setCustomBaseError(null);
    setBaseVariations([]);
    setEditPrompt('');
    setBrushSize(28);
    setMaskMode('paint');
    setEditError(null);
    setIsEditing(false);
    setMaskTool('brush');
    setStyleReferenceUrl('');
    setStyleSummary(null);
    setStylePalette([]);
    setStyleError(null);
    setIsStyleLoading(false);
    setUploadBaseFile(null);
    setUploadBaseError(null);
    setUploadRefFile(null);
    setLayoutProfileName('');
    setImagePresetName('');
    setImagePresets([]);
    setTextStyles({
      label: { color: '#22D3EE', fontSize: 28 },
      title: { color: '#FFFFFF', fontSize: 58 },
      meta: { color: '#E2E8F0', fontSize: 30 },
      cta: { color: '#FFFFFF', fontSize: 28 },
    });
  };

  const resetDraft = () => {
    setPostPrompt('');
    setPostPromptTemplate('');
    setPostOptions([]);
    setPostId(null);
    setPostType('');
    setPostLength('standard');
    setScheduleAt('');
    setCampaignId('');
    setBasePrompt('');
    setImagePromptTemplate('');
    setBaseImageUrl(null);
    setComposedUrl(null);
    setCompliance(null);
    setSelectedSourceIds([]);
    setCopyError(null);
    setImageError(null);
    setPublishError(null);
    setCampaignError(null);
    setCustomBaseUrl('');
    setCustomBaseError(null);
    setBaseVariations([]);
    setEditPrompt('');
    setEditError(null);
    setStyleReferenceUrl('');
    setStyleSummary(null);
    setStylePalette([]);
    setStyleError(null);
    setUploadBaseFile(null);
    setUploadBaseError(null);
    setUploadRefFile(null);
    setLayoutProfileName('');
    setImagePresetName('');
    setImagePresets([]);
    setTextStyles({
      label: { color: '#22D3EE', fontSize: 28 },
      title: { color: '#FFFFFF', fontSize: 58 },
      meta: { color: '#E2E8F0', fontSize: 30 },
      cta: { color: '#FFFFFF', fontSize: 28 },
    });
  };

  const applyBrandKitDefaults = () => {
    const preset = PALETTE_PRESETS.find((item) => item.id === 'linkedin') || PALETTE_PRESETS[0];
    setPalettePreset(preset?.id ?? '');
    setBrandKitForm({
      name: 'Default',
      primary_colors: preset?.primary ?? '#0A66C2',
      secondary_colors: preset?.secondary ?? '#0F172A',
      accent_colors: preset?.accent ?? '#22D3EE',
      font_personality: 'modern-sans',
      tone_guidelines: 'confident, clear, concise',
      allowed_image_styles: 'clean, minimal',
    });
  };

  const applyIdentityDefaults = () => {
    setIdentityForm({
      positioning: 'Category leader',
      voice_traits: 'confident, approachable, pragmatic',
      audience_personas: 'Marketing leaders, Sales leaders',
      preferred_phrases: 'Learn more, Book a demo',
      do_not_use: 'Guaranteed results, Best in the world',
    });
  };

  const applyMoodBoardDefaults = () => {
    setMoodBoardForm({
      name: 'Thought Leadership',
      palette_colors: '#0A66C2, #0F172A, #22D3EE',
      typography_mood: 'clean-sans',
      image_density: 'medium',
      composition_style: 'clean grid',
      emotional_tone: 'confident',
    });
  };

  const applyIndustryPreset = (presetId: string) => {
    const preset = INDUSTRY_PRESETS.find((item) => item.id === presetId);
    if (!preset) return;
    setIndustryPreset(preset.id);
    setPalettePreset(preset.brandKit.palettePreset || '');
    setBrandKitForm({
      name: preset.brandKit.name,
      primary_colors: preset.brandKit.primary,
      secondary_colors: preset.brandKit.secondary,
      accent_colors: preset.brandKit.accent,
      font_personality: preset.brandKit.font,
      tone_guidelines: preset.brandKit.tone.join(', '),
      allowed_image_styles: preset.brandKit.styles.join(', '),
    });
    setIdentityForm({
      positioning: preset.identity.positioning,
      voice_traits: preset.identity.voiceTraits.join(', '),
      audience_personas: preset.identity.audiencePersonas.join(', '),
      preferred_phrases: preset.identity.preferredPhrases.join(', '),
      do_not_use: preset.identity.doNotUse.join(', '),
    });
    setMoodBoardForm({
      name: preset.mood.name,
      palette_colors: preset.mood.palette.join(', '),
      typography_mood: preset.mood.typography,
      image_density: preset.mood.density,
      composition_style: preset.mood.composition,
      emotional_tone: preset.mood.tone,
    });
  };

  const saveTemplate = () => {
    if (!templateName.trim()) {
      setTemplateError('Name your template before saving.');
      return;
    }
    const template: StudioTemplate = {
      id: createTemplateId(),
      name: templateName.trim(),
      palettePreset,
      brandKitForm: { ...brandKitForm },
      identityForm: { ...identityForm },
      moodBoardForm: { ...moodBoardForm },
      postType,
      postLength,
      audienceLevel,
    };
    const next = [template, ...templates].slice(0, 12);
    setTemplates(next);
    if (typeof window !== 'undefined') {
      window.localStorage.setItem('studio_templates', JSON.stringify(next));
    }
    setTemplateName('');
    setTemplateError(null);
  };

  const applyTemplate = (template: StudioTemplate) => {
    setPalettePreset(template.palettePreset);
    setBrandKitForm({ ...template.brandKitForm });
    setIdentityForm({ ...template.identityForm });
    setMoodBoardForm({ ...template.moodBoardForm });
    setPostType(template.postType);
    setPostLength(template.postLength);
    setAudienceLevel(template.audienceLevel);
    setTemplateError(null);
  };

  const removeTemplate = (templateId: string) => {
    const next = templates.filter((template) => template.id !== templateId);
    setTemplates(next);
    if (typeof window !== 'undefined') {
      window.localStorage.setItem('studio_templates', JSON.stringify(next));
    }
  };

  const runQuickSetup = async () => {
    if (!brandId) {
      setQuickSetupError('Select a brand before running quick setup.');
      return;
    }
    const preset = INDUSTRY_PRESETS.find((item) => item.id === industryPreset) || INDUSTRY_PRESETS[0];
    if (!preset) return;
    setIsBusy(true);
    setQuickSetupError(null);
    setBrandKitError(null);
    setIdentityError(null);
    setMoodError(null);
    setProfileError(null);
    applyIndustryPreset(preset.id);

    try {
      const kitPayload = {
        brand_id: brandId,
        name: preset.brandKit.name,
        primary_colors: [preset.brandKit.primary],
        secondary_colors: [preset.brandKit.secondary],
        accent_colors: [preset.brandKit.accent],
        font_personality: preset.brandKit.font,
        tone_guidelines: preset.brandKit.tone,
        allowed_image_styles: preset.brandKit.styles,
      };
      const { data: kit, error: kitError } = await supabase
        .from('brand_kits')
        .insert(kitPayload)
        .select('*')
        .single();
      if (kitError || !kit) {
        setBrandKitError(kitError?.message || 'Failed to create brand kit.');
      } else {
        setBrandKits((prev) => [kit as BrandKit, ...prev]);
        setBrandKitId((kit as BrandKit).id);
      }

      const identityPayload = {
        brand_id: brandId,
        voice_traits: preset.identity.voiceTraits,
        positioning: preset.identity.positioning,
        audience_personas: preset.identity.audiencePersonas,
        do_not_use: preset.identity.doNotUse,
        preferred_phrases: preset.identity.preferredPhrases,
        updated_at: new Date().toISOString(),
      };
      const identityResponse = identityId
        ? await supabase
            .from('marketing_identities')
            .update(identityPayload)
            .eq('id', identityId)
            .select('*')
            .single()
        : await supabase.from('marketing_identities').insert(identityPayload).select('*').single();
      if (identityResponse.error || !identityResponse.data) {
        setIdentityError('Failed to save marketing identity.');
      } else {
        const identity = identityResponse.data as MarketingIdentity;
        setIdentityId(identity.id);
        setIdentityLocked(Boolean(identity.is_locked));
      }

      const moodPayload = {
        brand_id: brandId,
        name: preset.mood.name,
        palette_colors: preset.mood.palette,
        typography_mood: preset.mood.typography,
        image_density: preset.mood.density,
        composition_style: preset.mood.composition,
        emotional_tone: preset.mood.tone,
      };
      const { data: mood, error: moodError } = await supabase
        .from('mood_boards')
        .insert(moodPayload)
        .select('*')
        .single();
      if (moodError || !mood) {
        setMoodError(moodError?.message || 'Failed to save mood board.');
      } else {
        setMoodBoards((prev) => [mood as MoodBoard, ...prev]);
        setMoodBoardId((mood as MoodBoard).id);
      }

      const seedRes = await fetch('/api/pro/image-profiles/seed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brandId }),
      });
      if (!seedRes.ok) {
        const errorBody = await seedRes.json().catch(() => ({}));
        setProfileError(errorBody.error || 'Failed to seed image profiles.');
      } else {
        const data = await seedRes.json();
        setImageProfiles(data.profiles || []);
        const seededProfile = data.profiles?.[0];
        if (seededProfile?.id) {
          setImageProfileId(seededProfile.id);
        }
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Quick setup failed.';
      setQuickSetupError(message);
    } finally {
      setIsBusy(false);
    }
  };

  const runBatchGeneration = async () => {
    if (!brandId || !brandKitId || !moodBoardId) {
      setBatchError('Select a brand, brand kit, and mood board before batching.');
      return;
    }
    const prompts = batchPrompts
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
      .slice(0, 6);
    if (!prompts.length) {
      setBatchError('Add at least one topic (one per line).');
      return;
    }
    setIsBatching(true);
    setBatchError(null);
    const results: BatchRun[] = [];
    try {
      for (const prompt of prompts) {
        const res = await fetch('/api/pro/post-options', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            brandId,
            brandKitId,
            moodBoardId,
            imageProfileId: imageProfileId || null,
            prompt,
            postType: postType || undefined,
            length: postLength || undefined,
            sourceIds: selectedSourceIds,
            audienceLevel,
          }),
        });
        if (!res.ok) {
          const errorBody = await res.json().catch(() => ({}));
          setBatchError(errorBody.error || 'Batch generation failed on one of the prompts.');
          continue;
        }
        const data = await res.json();
        results.push({
          id: createTemplateId(),
          prompt,
          options: data.options || [],
          postId: data.post_id,
        });
      }
      setBatchRuns((prev) => [...results, ...prev]);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Batch generation failed.';
      setBatchError(message);
    } finally {
      setIsBatching(false);
    }
  };

  const loadBatchRun = (run: BatchRun) => {
    setPostPrompt(run.prompt);
    setPostOptions(run.options);
    setPostId(run.postId);
    setCopyError(null);
  };

  const runAutoFlow = async () => {
    if (!brandId) {
      setCopyError('Select a brand before running the AI wizard.');
      return;
    }
    if (!brandKitId) {
      setCopyError('Select a brand kit before running the AI wizard.');
      return;
    }
    if (!moodBoardId) {
      setCopyError('Select a mood board before running the AI wizard.');
      return;
    }
    if (!postPrompt.trim()) {
      setCopyError('Add a prompt before running the AI wizard.');
      return;
    }
    setIsBusy(true);
    setCopyError(null);
    setImageError(null);

    let resolvedProfileId = imageProfileId;
    if (!resolvedProfileId) {
      const existing = imageProfiles[0];
      if (existing?.id) {
        resolvedProfileId = existing.id;
        setImageProfileId(existing.id);
      } else {
        const seedRes = await fetch('/api/pro/image-profiles/seed', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ brandId }),
        });
        if (seedRes.ok) {
          const data = await seedRes.json();
          setImageProfiles(data.profiles || []);
          resolvedProfileId = data.profiles?.[0]?.id || '';
          if (resolvedProfileId) {
            setImageProfileId(resolvedProfileId);
          }
        }
      }
    }

    try {
      const res = await fetch('/api/pro/post-options', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          brandId,
          brandKitId,
          moodBoardId,
          imageProfileId: resolvedProfileId || null,
          prompt: postPrompt,
          postType: postType || undefined,
          length: postLength || undefined,
          sourceIds: selectedSourceIds,
          audienceLevel,
        }),
      });
      if (!res.ok) {
        const errorBody = await res.json().catch(() => ({}));
        setCopyError(errorBody.error || 'Failed to generate options.');
        setIsBusy(false);
        return;
      }
      const data = await res.json();
      const options = data.options || [];
      setPostOptions(options);
      setPostId(data.post_id);
      setBaseImageUrl(null);
      setComposedUrl(null);
      setCompliance(null);

      let resolvedTextBlocks = textBlocks;
      if (options.length) {
        setPostOptions((prev) => prev.map((option, index) => ({ ...option, selected: index === 0 })));
        await fetch('/api/pro/post-options/select', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId: data.post_id, optionIndex: 0 }),
        });
        const primary = options[0];
        resolvedTextBlocks = {
          ...textBlocks,
          title: primary.headline || textBlocks.title,
          meta: primary.hook || primary.body || textBlocks.meta,
          cta: primary.cta || textBlocks.cta,
        };
        setTextBlocks(resolvedTextBlocks);
      }

      if (autoCompose) {
        const baseRes = await fetch('/api/pro/image/base', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            postId: data.post_id,
            brandId,
            brandKitId,
            moodBoardId,
            imageProfileId: resolvedProfileId || null,
            userPrompt: buildImagePrompt(basePrompt || postPrompt),
            size: imageSize,
            quality: imageQuality,
            outputFormat: imageFormat,
          }),
        });
        if (!baseRes.ok) {
          const errorBody = await baseRes.json().catch(() => ({}));
          setImageError(errorBody.error || 'Failed to generate base image.');
          setIsBusy(false);
          return;
        }
        const baseData = await baseRes.json();
        setBaseImageUrl(baseData.file_url);
        if (!resolvedProfileId) {
          setImageError('Select an image profile before composing.');
          setIsBusy(false);
          return;
        }
        const composeRes = await fetch('/api/pro/image/compose', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              postId: data.post_id,
              brandId,
              brandKitId,
              moodBoardId,
              imageProfileId: resolvedProfileId,
              baseAssetId: baseData.asset_id,
              textBlocks: [
                { id: 'label', type: 'label', text: resolvedTextBlocks.label },
                { id: 'title', type: 'title', text: resolvedTextBlocks.title },
                { id: 'meta', type: 'meta', text: resolvedTextBlocks.meta },
                { id: 'cta', type: 'cta', text: resolvedTextBlocks.cta },
              ],
              logoPlacement,
              logoScale,
              logoPadding,
              bannerStyle,
              bannerColor,
              bannerOpacity,
        overlayOpacity,
        baseTransform: {
          scale: baseScale,
          x: baseOffsetX,
          y: baseOffsetY,
        },
        filters: {
          brightness,
          contrast,
          saturation,
          blur,
        },
        textStyles,
        layoutOverride: layoutOverride || undefined,
      }),
    });
        if (!composeRes.ok) {
          const errorBody = await composeRes.json().catch(() => ({}));
          setImageError(errorBody.error || 'Failed to compose image.');
          setIsBusy(false);
          return;
        }
        const composedData = await composeRes.json();
        setComposedUrl(composedData.file_url);
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'AI wizard failed.';
      setCopyError(message);
    } finally {
      setIsBusy(false);
    }
  };

  const runHealthCheck = async () => {
    setIsHealthChecking(true);
    setHealthError(null);
    try {
      const res = await fetch('/api/pro/health');
      if (!res.ok) {
        const errorBody = await res.json().catch(() => ({}));
        setHealthError(errorBody.error || 'Health check failed.');
        setIsHealthChecking(false);
        return;
      }
      const data = await res.json();
      setHealthStatus(data);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Health check failed.';
      setHealthError(message);
    } finally {
      setIsHealthChecking(false);
    }
  };

  const runBrandBrief = async () => {
    if (!brandBrief.trim()) {
      setBrandBriefError('Describe your brand before generating a setup.');
      return;
    }
    setBrandBriefLoading(true);
    setBrandBriefError(null);
    try {
      const res = await fetch('/api/pro/brand-intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brief: brandBrief }),
      });
      if (!res.ok) {
        const errorBody = await res.json().catch(() => ({}));
        setBrandBriefError(errorBody.error || 'Failed to generate brand setup.');
        setBrandBriefLoading(false);
        return;
      }
      const data = await res.json();
      setBrandKitForm({
        name: data.brand_kit.name || 'Default',
        primary_colors: data.brand_kit.primary_colors?.[0] || '#0A66C2',
        secondary_colors: data.brand_kit.secondary_colors?.[0] || '#0F172A',
        accent_colors: data.brand_kit.accent_colors?.[0] || '#22D3EE',
        font_personality: data.brand_kit.font_personality || 'modern-sans',
        tone_guidelines: (data.brand_kit.tone_guidelines || []).join(', '),
        allowed_image_styles: (data.brand_kit.allowed_image_styles || []).join(', '),
      });
      setIdentityForm({
        positioning: data.identity.positioning || '',
        voice_traits: (data.identity.voice_traits || []).join(', '),
        audience_personas: (data.identity.audience_personas || []).join(', '),
        do_not_use: (data.identity.do_not_use || []).join(', '),
        preferred_phrases: (data.identity.preferred_phrases || []).join(', '),
      });
      setMoodBoardForm({
        name: data.mood_board.name || '',
        palette_colors: (data.mood_board.palette_colors || []).join(', '),
        typography_mood: data.mood_board.typography_mood || '',
        image_density: data.mood_board.image_density || '',
        composition_style: data.mood_board.composition_style || '',
        emotional_tone: data.mood_board.emotional_tone || '',
      });
      setPostType(data.post_strategy?.post_type || '');
      setPostLength((data.post_strategy?.length as 'short' | 'standard' | 'long') || 'standard');
      setAudienceLevel(
        (data.post_strategy?.audience_level as 'executive' | 'practitioner' | 'general') || 'general'
      );
      setPalettePreset('');
      setBrandBriefResult({
        brandKitName: data.brand_kit.name || 'Default',
        tone: (data.brand_kit.tone_guidelines || []).slice(0, 2).join(', ') || 'Neutral',
        mood: data.mood_board.name || 'Custom',
        audience: (data.identity.audience_personas || []).slice(0, 2).join(', ') || 'General',
      });
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to generate brand setup.';
      setBrandBriefError(message);
    } finally {
      setBrandBriefLoading(false);
    }
  };

  const saveBrandBriefToDatabase = async () => {
    if (!brandId) {
      setBrandBriefSaveError('Select a brand before saving.');
      return;
    }
    setBrandBriefSaving(true);
    setBrandBriefSaveError(null);
    setBrandBriefSaveSuccess(null);
    try {
      const kitPayload = {
        brand_id: brandId,
        name: brandKitForm.name || 'Default',
        primary_colors: parseList(brandKitForm.primary_colors),
        secondary_colors: parseList(brandKitForm.secondary_colors),
        accent_colors: parseList(brandKitForm.accent_colors),
        font_personality: brandKitForm.font_personality,
        tone_guidelines: parseList(brandKitForm.tone_guidelines),
        allowed_image_styles: parseList(brandKitForm.allowed_image_styles),
      };
      const { data: kit, error: kitError } = await supabase
        .from('brand_kits')
        .insert(kitPayload)
        .select('*')
        .single();
      if (kitError || !kit) {
        setBrandBriefSaveError(kitError?.message || 'Failed to save brand kit.');
        setBrandBriefSaving(false);
        return;
      }
      setBrandKits((prev) => [kit as BrandKit, ...prev]);
      setBrandKitId((kit as BrandKit).id);

      const identityPayload = {
        brand_id: brandId,
        voice_traits: parseList(identityForm.voice_traits),
        positioning: identityForm.positioning || null,
        audience_personas: parseList(identityForm.audience_personas),
        do_not_use: parseList(identityForm.do_not_use),
        preferred_phrases: parseList(identityForm.preferred_phrases),
        updated_at: new Date().toISOString(),
      };
      const identityResponse = await supabase
        .from('marketing_identities')
        .insert(identityPayload)
        .select('*')
        .single();
      if (identityResponse.error || !identityResponse.data) {
        setBrandBriefSaveError('Failed to save marketing identity.');
        setBrandBriefSaving(false);
        return;
      }
      const identity = identityResponse.data as MarketingIdentity;
      setIdentityId(identity.id);
      setIdentityLocked(Boolean(identity.is_locked));

      const moodPayload = {
        brand_id: brandId,
        name: moodBoardForm.name || 'Mood Board',
        palette_colors: parseList(moodBoardForm.palette_colors),
        typography_mood: moodBoardForm.typography_mood,
        image_density: moodBoardForm.image_density,
        composition_style: moodBoardForm.composition_style,
        emotional_tone: moodBoardForm.emotional_tone,
      };
      const { data: mood, error: moodError } = await supabase
        .from('mood_boards')
        .insert(moodPayload)
        .select('*')
        .single();
      if (moodError || !mood) {
        setBrandBriefSaveError(moodError?.message || 'Failed to save mood board.');
        setBrandBriefSaving(false);
        return;
      }
      setMoodBoards((prev) => [mood as MoodBoard, ...prev]);
      setMoodBoardId((mood as MoodBoard).id);

      setBrandBriefSaveSuccess('Brand kit, identity, and mood board saved.');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to save brand setup.';
      setBrandBriefSaveError(message);
    } finally {
      setBrandBriefSaving(false);
    }
  };

  const scheduleBatchPosts = async () => {
    if (!batchRuns.length) {
      setBatchScheduleError('Generate a batch before scheduling.');
      return;
    }
    const startDate = new Date(batchScheduleStart);
    if (Number.isNaN(startDate.getTime())) {
      setBatchScheduleError('Select a valid start time for batch scheduling.');
      return;
    }
    setIsBusy(true);
    setBatchScheduleError(null);
    setBatchScheduleSuccess(null);
    let successCount = 0;
    for (let i = 0; i < batchRuns.length; i += 1) {
      const run = batchRuns[i];
      const scheduledFor = new Date(startDate.getTime() + i * batchScheduleIntervalDays * 24 * 60 * 60 * 1000);
      const { error } = await supabase
        .from('posts')
        .update({ scheduled_for: scheduledFor.toISOString(), status: 'scheduled' })
        .eq('id', run.postId);
      if (!error) {
        successCount += 1;
      }
    }
    setIsBusy(false);
    if (successCount === 0) {
      setBatchScheduleError('Failed to schedule batch posts.');
    } else {
      setBatchScheduleSuccess(`Scheduled ${successCount} post(s).`);
    }
  };

  const openWizard = () => {
    setWizardOpen(true);
    setWizardStep(0);
    setGuidedMode(true);
    setActiveTab('overview');
  };

  const goToWizardStep = (index: number) => {
    const next = wizardSteps[index];
    if (!next) return;
    setWizardStep(index);
    setActiveTab(next.tab);
  };

  const buildOptionReasons = () => {
    const reasons: string[] = [];
    if (postType) reasons.push(`Format: ${formatOptionLabel(postType)}`);
    if (postLength) reasons.push(`Length: ${formatOptionLabel(postLength)}`);
    if (audienceLevel) {
      const label = AUDIENCE_LEVELS.find((level) => level.value === audienceLevel)?.label;
      if (label) reasons.push(`Audience: ${label}`);
    }
    if (selectedSourceIds.length) reasons.push(`Grounded in ${selectedSourceIds.length} source(s)`);
    if (identityForm.positioning) reasons.push(`Positioning: ${identityForm.positioning}`);
    if (activeMoodBoard?.name) reasons.push(`Mood: ${activeMoodBoard.name}`);
    return reasons;
  };

  const createBrand = async () => {
    if (!brandName) {
      setBrandError('Enter a brand name to continue.');
      return;
    }
    if (!userId) {
      setBrandError('Sign in to create a brand.');
      return;
    }
    setIsBusy(true);
    setBrandError(null);
    const { data, error } = await supabase
      .from('brands')
      .insert({ name: brandName, owner_user_id: userId })
      .select('*')
      .single();
    setIsBusy(false);
    if (error || !data) {
      setBrandError(error?.message || 'Failed to create brand.');
      return;
    }
    setBrands((prev) => [data as Brand, ...prev]);
    selectBrand((data as Brand).id);
    setBrandName('');
  };

  const createBrandKit = async () => {
    if (!brandId) {
      setBrandKitError('Select a brand before saving a kit.');
      return;
    }
    if (!brandKitForm.name) {
      setBrandKitError('Choose a kit name before saving.');
      return;
    }
    setIsBusy(true);
    setBrandKitError(null);
    const payload = {
      brand_id: brandId,
      name: brandKitForm.name,
      primary_colors: parseList(brandKitForm.primary_colors),
      secondary_colors: parseList(brandKitForm.secondary_colors),
      accent_colors: parseList(brandKitForm.accent_colors),
      font_personality: brandKitForm.font_personality,
      tone_guidelines: parseList(brandKitForm.tone_guidelines),
      allowed_image_styles: parseList(brandKitForm.allowed_image_styles),
    };
    const { data, error } = await supabase.from('brand_kits').insert(payload).select('*').single();
    setIsBusy(false);
    if (error || !data) {
      setBrandKitError(error?.message || 'Failed to save brand kit.');
      return;
    }
    setBrandKits((prev) => [data as BrandKit, ...prev]);
    setBrandKitId((data as BrandKit).id);
    setBrandKitForm({
      name: '',
      primary_colors: '',
      secondary_colors: '',
      accent_colors: '',
      font_personality: '',
      tone_guidelines: '',
      allowed_image_styles: '',
    });
    setPalettePreset('');
  };

  const uploadLogo = async () => {
    if (!brandId || !brandKitId) {
      setLogoError('Select a brand kit before uploading logos.');
      return;
    }
    if (!logoFile) {
      setLogoError('Choose a logo file to upload.');
      return;
    }
    setIsBusy(true);
    setLogoError(null);
    const formData = new FormData();
    formData.append('brandId', brandId);
    formData.append('brandKitId', brandKitId);
    formData.append('file', logoFile);

    const res = await fetch('/api/pro/brand-kit/logo', {
      method: 'POST',
      body: formData,
    });

    setIsBusy(false);

    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setLogoError(errorBody.error || 'Failed to upload logo.');
      return;
    }

    const data = await res.json();
    if (data.brand_kit) {
      setBrandKits((prev) => prev.map((kit) => (kit.id === data.brand_kit.id ? data.brand_kit : kit)));
    }
    setLogoFile(null);
  };

  const removeLogo = async (assetId?: string, url?: string) => {
    if (!brandKitId) {
      setLogoError('Select a brand kit to manage logos.');
      return;
    }
    setIsBusy(true);
    setLogoError(null);
    const res = await fetch('/api/pro/brand-kit/logo', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ brandKitId, assetId, url }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setLogoError(errorBody.error || 'Failed to remove logo.');
      return;
    }
    const data = await res.json();
    if (data.brand_kit) {
      setBrandKits((prev) => prev.map((kit) => (kit.id === data.brand_kit.id ? data.brand_kit : kit)));
    }
  };

  const setPrimaryLogo = async (assetId?: string, url?: string) => {
    if (!brandKitId) {
      setLogoError('Select a brand kit to set a primary logo.');
      return;
    }
    if (!assetId && !url) {
      setLogoError('Choose a logo to set as primary.');
      return;
    }
    const kit = activeBrandKit;
    if (!kit?.logo_assets?.length) return;

    const nextAssets = [...kit.logo_assets];
    const index = nextAssets.findIndex(
      (asset) => (assetId && asset.asset_id === assetId) || (url && asset.url === url)
    );
    if (index <= 0) return;
    const [selected] = nextAssets.splice(index, 1);
    nextAssets.unshift(selected);

    setIsBusy(true);
    const { data, error } = await supabase
      .from('brand_kits')
      .update({ logo_assets: nextAssets })
      .eq('id', brandKitId)
      .select('*')
      .single();
    setIsBusy(false);
    if (!error && data) {
      setBrandKits((prev) => prev.map((kitItem) => (kitItem.id === data.id ? (data as BrandKit) : kitItem)));
    }
  };

  const saveIdentity = async () => {
    if (!brandId) {
      setIdentityError('Select a brand before saving an identity.');
      return;
    }
    setIsBusy(true);
    setIdentityError(null);
    const payload = {
      brand_id: brandId,
      voice_traits: parseList(identityForm.voice_traits),
      positioning: identityForm.positioning || null,
      audience_personas: parseList(identityForm.audience_personas),
      do_not_use: parseList(identityForm.do_not_use),
      preferred_phrases: parseList(identityForm.preferred_phrases),
      updated_at: new Date().toISOString(),
    };

    const response = identityId
      ? await supabase
          .from('marketing_identities')
          .update(payload)
          .eq('id', identityId)
          .select('*')
          .single()
      : await supabase.from('marketing_identities').insert(payload).select('*').single();

    setIsBusy(false);

    if (response.error || !response.data) {
      setIdentityError('Failed to save marketing identity.');
      return;
    }

    const identity = response.data as MarketingIdentity;
    setIdentityId(identity.id);
    setIdentityLocked(Boolean(identity.is_locked));
  };

  const lockIdentity = async () => {
    if (!identityId) {
      setIdentityError('Save the marketing identity before locking it.');
      return;
    }
    if (identityLocked) {
      setIdentityError('This identity is already locked.');
      return;
    }
    setIsBusy(true);
    setIdentityError(null);

    const { data, error } = await supabase
      .from('marketing_identities')
      .update({
        is_locked: true,
        locked_by: userId,
        locked_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      })
      .eq('id', identityId)
      .select('*')
      .single();

    setIsBusy(false);

    if (error || !data) {
      setIdentityError('Failed to lock marketing identity.');
      return;
    }

    setIdentityLocked(true);
  };

