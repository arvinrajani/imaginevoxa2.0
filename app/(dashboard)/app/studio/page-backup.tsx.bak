    const scheduled = scheduleAt ? new Date(scheduleAt).toISOString() : null;
    const { error } = await supabase
      .from('posts')
      .update({
        scheduled_for: scheduled,
        status: scheduled ? 'scheduled' : 'draft',
      })
      .eq('id', postId);
    setIsBusy(false);
    if (error) {
      setCampaignError(error.message || 'Failed to save schedule.');
      return;
    }
    setScheduleAt(scheduleAt);
    setCampaignError(null);
  };

  const ingestSource = async () => {
    if (!brandId) {
      setSourceError('Select a brand before ingesting sources.');
      return;
    }
    if (!sourceUrl) {
      setSourceError('Paste a URL to ingest.');
      return;
    }
    setIsBusy(true);
    setSourceError(null);
    const res = await fetch('/api/pro/sources/ingest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        brandId,
        url: sourceUrl,
        postId: postId ?? null,
        sourceType,
      }),
    });
    setIsBusy(false);
    if (res.ok) {
      const data = await res.json();
      if (data.source) {
        setSources((prev) => [data.source as ContentSource, ...prev.filter((item) => item.id !== data.source.id)]);
        setSelectedSourceIds((prev) => Array.from(new Set([data.source.id, ...prev])));
        setSourceUrl('');
      }
      return;
    }
    const errorBody = await res.json().catch(() => ({}));
    setSourceError(errorBody.error || 'Failed to ingest source');
  };

  const toggleSource = (sourceId: string) => {
    setSelectedSourceIds((prev) =>
      prev.includes(sourceId) ? prev.filter((id) => id !== sourceId) : [...prev, sourceId]
    );
  };

  const generateOptions = async () => {
    if (!brandId) {
      setCopyError('Select a brand before generating options.');
      return;
    }
    if (!brandKitId) {
      setCopyError('Select a brand kit before generating options.');
      return;
    }
    if (!moodBoardId) {
      setCopyError('Select a mood board before generating options.');
      return;
    }
    if (!postPrompt.trim()) {
      setCopyError('Add a post prompt before generating options.');
      return;
    }
    setIsBusy(true);
    setCopyError(null);
    const res = await fetch('/api/pro/post-options', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        brandId,
        brandKitId,
        moodBoardId,
        imageProfileId: imageProfileId || null,
        prompt: postPrompt,
        postType: postType || undefined,
        length: postLength || undefined,
        sourceIds: selectedSourceIds,
        audienceLevel,
      }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setCopyError(errorBody.error || 'Failed to generate options.');
      return;
    }
    const data = await res.json();
    setPostOptions(data.options || []);
    setPostId(data.post_id);
    setBaseImageUrl(null);
    setComposedUrl(null);
    setCompliance(null);
    setScheduleAt('');
  };

  const selectOption = async (index: number) => {
    if (!postId) {
      setCopyError('Generate options before selecting one.');
      return;
    }
    setIsBusy(true);
    const res = await fetch('/api/pro/post-options/select', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId, optionIndex: index }),
    });
    setIsBusy(false);
    if (res.ok) {
      setPostOptions((prev) => prev.map((option, i) => ({ ...option, selected: i === index })));
    }
  };

  const copySelectedOption = async () => {
    if (!selectedOption || !postPreview) return;
    try {
      await navigator.clipboard.writeText(postPreview);
    } catch {
      // Clipboard may be blocked; ignore.
    }
  };

  const startDragZone = (zoneId: string) => (event: ReactPointerEvent<HTMLDivElement>) => {
    event.preventDefault();
    if (!manualLayout) return;
    if (Object.keys(layoutZones).length === 0) {
      const next = DEFAULT_LAYOUT_ZONES.reduce<Record<string, LayoutZone>>((acc, zone) => {
        acc[zone.id] = { ...zone };
        return acc;
      }, {});
      setLayoutZones(next);
    }
    setDraggingZone(zoneId);
  };

  const handlePreviewMove = (event: ReactPointerEvent<HTMLDivElement>) => {
    if (!manualLayout || !draggingZone || !previewRef.current) return;
    const rect = previewRef.current.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const pointerX = event.clientX - rect.left;
    const pointerY = event.clientY - rect.top;
    const base = layoutPreviewZones.find((zone) => zone.id === draggingZone);
    if (!base) return;
    const nextX = clamp(pointerX / rect.width - base.w / 2, 0, 1 - base.w);
    const nextY = clamp(pointerY / rect.height - base.h / 2, 0, 1 - base.h);
    setLayoutZones((prev) => ({
      ...prev,
      [draggingZone]: { ...base, x: nextX, y: nextY },
    }));
  };

  const stopDragging = () => {
    setDraggingZone(null);
  };

  const resetLayout = () => {
    setLayoutZones({});
    setManualLayout(false);
  };

  const resetImageAdjustments = () => {
    setLogoScale(1);
    setLogoPadding(8);
    setBannerStyle('none');
    setBannerColor('#0F172A');
    setBannerOpacity(0.45);
    setOverlayOpacity(0.12);
    setBaseScale(1);
    setBaseOffsetX(0);
    setBaseOffsetY(0);
    setBrightness(1);
    setContrast(1);
    setSaturation(1);
    setBlur(0);
  };

  const uploadBaseImageFile = async () => {
    if (!postId || !brandId) {
      setUploadBaseError('Generate a post before uploading a base image.');
      return;
    }
    if (!uploadBaseFile) {
      setUploadBaseError('Choose a file to upload.');
      return;
    }
    setIsBusy(true);
    setUploadBaseError(null);
    const formData = new FormData();
    formData.append('postId', postId);
    formData.append('brandId', brandId);
    formData.append('file', uploadBaseFile);
    const res = await fetch('/api/pro/image/upload-base', {
      method: 'POST',
      body: formData,
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setUploadBaseError(errorBody.error || 'Failed to upload base image.');
      return;
    }
    const data = await res.json();
    setBaseImageUrl(data.file_url);
    setUploadBaseFile(null);
    setBaseVariations([]);
  };

  const uploadReferenceFile = async () => {
    if (!uploadRefFile) {
      setStyleError('Choose a reference image to upload.');
      return;
    }
    setIsStyleLoading(true);
    setStyleError(null);
    const formData = new FormData();
    formData.append('file', uploadRefFile);
    const res = await fetch('/api/pro/image/upload', {
      method: 'POST',
      body: formData,
    });
    setIsStyleLoading(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setStyleError(errorBody.error || 'Failed to upload reference image.');
      return;
    }
    const data = await res.json();
    setStyleReferenceUrl(data.file_url || '');
    setUploadRefFile(null);
  };

  const analyzeStyleReference = async () => {
    if (!styleReferenceUrl) {
      setStyleError('Paste or upload a reference image URL.');
      return;
    }
    setIsStyleLoading(true);
    setStyleError(null);
    const res = await fetch('/api/pro/image/style-reference', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrl: styleReferenceUrl }),
    });
    setIsStyleLoading(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setStyleError(errorBody.error || 'Failed to analyze style.');
      return;
    }
    const data = await res.json();
    setStyleSummary(data.style_summary || null);
    setStylePalette(Array.isArray(data.palette) ? data.palette : []);
  };

  const saveLayoutProfile = async () => {
    if (!brandId) {
      setProfileError('Select a brand before saving a layout.');
      return;
    }
    if (!layoutOverride) {
      setProfileError('Enable manual layout and move zones before saving.');
      return;
    }
    if (!layoutProfileName.trim()) {
      setProfileError('Name the layout before saving.');
      return;
    }
    setIsBusy(true);
    setProfileError(null);
    const { data, error } = await supabase
      .from('image_profiles')
      .insert({
        brand_id: brandId,
        name: layoutProfileName.trim(),
        category: 'custom',
        description: 'Saved from manual layout editor.',
        layout_spec: layoutOverride,
        is_system: false,
      })
      .select('*')
      .single();
    setIsBusy(false);
    if (error || !data) {
      setProfileError(error?.message || 'Failed to save layout profile.');
      return;
    }
    setImageProfiles((prev) => [data as ImageProfile, ...prev]);
    setImageProfileId(data.id);
    setLayoutProfileName('');
  };

  const saveImagePreset = () => {
    if (!brandId) return;
    if (!imagePresetName.trim()) {
      setImageError('Name the preset before saving.');
      return;
    }
    const settings = {
      logoPlacement,
      logoScale,
      logoPadding,
      bannerStyle,
      bannerColor,
      bannerOpacity,
      overlayOpacity,
      baseScale,
      baseOffsetX,
      baseOffsetY,
      brightness,
      contrast,
      saturation,
      blur,
      textStyles,
    };
    const preset = { id: createTemplateId(), name: imagePresetName.trim(), settings };
    const next = [preset, ...imagePresets].slice(0, 12);
    setImagePresets(next);
    setImagePresetName('');
    if (typeof window !== 'undefined') {
      window.localStorage.setItem(`image_presets_${brandId}`, JSON.stringify(next));
    }
  };

  const applyImagePreset = (preset: { settings: Record<string, unknown> }) => {
    const settings = preset.settings;
    const asNumber = (value: unknown, fallback: number) =>
      typeof value === 'number' ? value : fallback;
    const asString = (value: unknown, fallback: string) =>
      typeof value === 'string' ? value : fallback;
    setLogoPlacement(asString(settings.logoPlacement, 'top-right') as typeof logoPlacement);
    setLogoScale(asNumber(settings.logoScale, 1));
    setLogoPadding(asNumber(settings.logoPadding, 8));
    setBannerStyle(asString(settings.bannerStyle, 'none') as typeof bannerStyle);
    setBannerColor(asString(settings.bannerColor, '#0F172A'));
    setBannerOpacity(asNumber(settings.bannerOpacity, 0.45));
    setOverlayOpacity(asNumber(settings.overlayOpacity, 0.12));
    setBaseScale(asNumber(settings.baseScale, 1));
    setBaseOffsetX(asNumber(settings.baseOffsetX, 0));
    setBaseOffsetY(asNumber(settings.baseOffsetY, 0));
    setBrightness(asNumber(settings.brightness, 1));
    setContrast(asNumber(settings.contrast, 1));
    setSaturation(asNumber(settings.saturation, 1));
    setBlur(asNumber(settings.blur, 0));
    if (settings.textStyles && typeof settings.textStyles === 'object') {
      setTextStyles(settings.textStyles as Record<string, { color?: string; fontSize?: number }>);
    }
  };

  const removeImagePreset = (presetId: string) => {
    if (!brandId) return;
    const next = imagePresets.filter((preset) => preset.id !== presetId);
    setImagePresets(next);
    if (typeof window !== 'undefined') {
      window.localStorage.setItem(`image_presets_${brandId}`, JSON.stringify(next));
    }
  };

  const drawAtPoint = (clientX: number, clientY: number) => {
    const canvas = maskCanvasRef.current;
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const x = ((clientX - rect.left) / rect.width) * canvas.width;
    const y = ((clientY - rect.top) / rect.height) * canvas.height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'white';
    ctx.lineWidth = brushSize;
    ctx.globalCompositeOperation = maskMode === 'erase' ? 'destination-out' : 'source-over';
    const last = lastPointRef.current;
    if (last) {
      ctx.beginPath();
      ctx.moveTo(last.x, last.y);
      ctx.lineTo(x, y);
      ctx.stroke();
    } else {
      ctx.beginPath();
      ctx.arc(x, y, brushSize / 2, 0, Math.PI * 2);
      ctx.fillStyle = 'white';
      ctx.fill();
    }
    lastPointRef.current = { x, y };
  };

  const handleMaskPointerDown = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    if (!baseImageUrl) return;
    isDrawingRef.current = true;
    if (maskTool === 'brush') {
      drawAtPoint(event.clientX, event.clientY);
      return;
    }
    const canvas = maskCanvasRef.current;
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const x = ((event.clientX - rect.left) / rect.width) * canvas.width;
    const y = ((event.clientY - rect.top) / rect.height) * canvas.height;
    shapeStartRef.current = { x, y };
    lastPointRef.current = { x, y };
  };

  const handleMaskPointerMove = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    if (!isDrawingRef.current) return;
    if (maskTool === 'brush') {
      drawAtPoint(event.clientX, event.clientY);
      return;
    }
    const canvas = maskCanvasRef.current;
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const x = ((event.clientX - rect.left) / rect.width) * canvas.width;
    const y = ((event.clientY - rect.top) / rect.height) * canvas.height;
    lastPointRef.current = { x, y };
  };

  const handleMaskPointerUp = () => {
    if (maskTool !== 'brush' && shapeStartRef.current && maskCanvasRef.current) {
      const canvas = maskCanvasRef.current;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = 'white';
        ctx.fillStyle = 'white';
        ctx.lineWidth = brushSize;
        ctx.globalCompositeOperation = maskMode === 'erase' ? 'destination-out' : 'source-over';
        const start = shapeStartRef.current;
        const end = lastPointRef.current || start;
        const width = end.x - start.x;
        const height = end.y - start.y;
        if (maskTool === 'rect') {
          ctx.beginPath();
          ctx.rect(start.x, start.y, width, height);
          ctx.fill();
        } else if (maskTool === 'circle') {
          const radius = Math.sqrt(width * width + height * height) / 2;
          const centerX = start.x + width / 2;
          const centerY = start.y + height / 2;
          ctx.beginPath();
          ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
          ctx.fill();
        } else if (maskTool === 'line') {
          ctx.beginPath();
          ctx.moveTo(start.x, start.y);
          ctx.lineTo(end.x, end.y);
          ctx.stroke();
        }
      }
    }
    isDrawingRef.current = false;
    lastPointRef.current = null;
    shapeStartRef.current = null;
  };

  const clearMask = () => {
    const canvas = maskCanvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  };

  const generateEdit = async () => {
    if (!postId || !brandId) {
      setEditError('Generate a post before editing the image.');
      return;
    }
    if (!editPrompt.trim()) {
      setEditError('Describe the change you want the AI to make.');
      return;
    }
    if (!baseImageUrl) {
      setEditError('Generate or choose a base image first.');
      return;
    }
    const canvas = maskCanvasRef.current;
    if (!canvas) {
      setEditError('Mask canvas not ready.');
      return;
    }
    setIsEditing(true);
    setEditError(null);
    const maskDataUrl = canvas.toDataURL('image/png');
    const baseAssetRes = await supabase
      .from('posts')
      .select('base_image_asset_id')
      .eq('id', postId)
      .single();
    if (baseAssetRes.error) {
      setEditError(baseAssetRes.error.message || 'Failed to load base image asset.');
      setIsEditing(false);
      return;
    }
    const baseAssetId = baseAssetRes.data?.base_image_asset_id;
    if (!baseAssetId) {
      setEditError('Base image asset missing. Generate a base image first.');
      setIsEditing(false);
      return;
    }
    const res = await fetch('/api/pro/image/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId,
        brandId,
        baseAssetId,
        prompt: buildImagePrompt(editPrompt),
        maskDataUrl,
        size: imageSize,
        outputFormat: imageFormat,
      }),
    });
    setIsEditing(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setEditError(errorBody.error || 'Failed to edit image.');
      return;
    }
    const data = await res.json();
    setBaseImageUrl(data.file_url);
    setBaseVariations([]);
    clearMask();
  };

  const registerBaseImageFromUrl = async () => {
    if (!postId) {
      setCustomBaseError('Generate a post before attaching a base image.');
      return;
    }
    if (!brandId) {
      setCustomBaseError('Select a brand before attaching a base image.');
      return;
    }
    if (!customBaseUrl.trim()) {
      setCustomBaseError('Paste an image URL to use as the base image.');
      return;
    }
    setIsBusy(true);
    setCustomBaseError(null);
    const [width, height] = imageSize.split('x').map((value) => Number(value));
    const res = await fetch('/api/pro/image/asset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId,
        brandId,
        url: customBaseUrl.trim(),
        width: Number.isFinite(width) ? width : undefined,
        height: Number.isFinite(height) ? height : undefined,
      }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setCustomBaseError(errorBody.error || 'Failed to register base image.');
      return;
    }
    const data = await res.json();
    setBaseImageUrl(data.file_url);
    setCustomBaseUrl('');
  };

  const generateVariations = async () => {
    if (!postId || !brandId || !brandKitId || !moodBoardId) {
      setImageError('Select a brand kit and mood board before generating variations.');
      return;
    }
    if (!postPrompt.trim()) {
      setImageError('Add a post prompt before generating variations.');
      return;
    }
    setIsBusy(true);
    setImageError(null);
    const results: Array<{ id: string; url: string }> = [];
    for (let i = 0; i < 4; i += 1) {
      const res = await fetch('/api/pro/image/base', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          postId,
          brandId,
          brandKitId,
          moodBoardId,
          imageProfileId: imageProfileId || null,
            userPrompt: buildImagePrompt(basePrompt || postPrompt),
          size: imageSize,
          quality: imageQuality,
          outputFormat: imageFormat,
        }),
      });
      if (!res.ok) {
        const errorBody = await res.json().catch(() => ({}));
        setImageError(errorBody.error || 'Failed to generate variations.');
        break;
      }
      const data = await res.json();
      if (data.asset_id && data.file_url) {
        results.push({ id: data.asset_id, url: data.file_url });
      }
    }
    if (results.length > 0) {
      setBaseVariations(results);
      setBaseImageUrl(results[0].url);
    }
    setIsBusy(false);
  };

  const selectVariation = async (variation: { id: string; url: string }) => {
    if (!postId) return;
    setIsBusy(true);
    const res = await fetch('/api/pro/image/select-base', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId,
        assetId: variation.id,
        fileUrl: variation.url,
      }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setImageError(errorBody.error || 'Failed to select variation.');
      return;
    }
    setBaseImageUrl(variation.url);
  };

  const generateBaseImage = async () => {
    if (!postId) {
      setImageError('Generate copy options before creating an image.');
      return;
    }
    if (!brandId || !brandKitId || !moodBoardId) {
      setImageError('Select a brand kit and mood board before generating an image.');
      return;
    }
    if (!postPrompt.trim()) {
      setImageError('Add a post prompt before generating an image.');
      return;
    }
    setIsBusy(true);
    setImageError(null);
    const res = await fetch('/api/pro/image/base', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId,
        brandId,
        brandKitId,
        moodBoardId,
        imageProfileId: imageProfileId || null,
          userPrompt: buildImagePrompt(basePrompt || postPrompt),
        size: imageSize,
        quality: imageQuality,
        outputFormat: imageFormat,
      }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setImageError(errorBody.error || 'Failed to generate base image.');
      return;
    }
    const data = await res.json();
    setBaseImageUrl(data.file_url);
    setBaseVariations([]);
  };

  const applySelectedOptionToTextBlocks = () => {
    if (!selectedOption) return;
    setTextBlocks((prev) => ({
      ...prev,
      title: selectedOption.headline || prev.title,
      meta: selectedOption.hook || selectedOption.body || prev.meta,
      cta: selectedOption.cta || prev.cta,
    }));
  };

  const composeImage = async () => {
    if (!postId) {
      setImageError('Generate a post before composing an image.');
      return;
    }
    if (!brandId || !brandKitId || !moodBoardId) {
      setImageError('Select a brand kit and mood board before composing an image.');
      return;
    }
    let resolvedProfileId = imageProfileId;
    if (!resolvedProfileId) {
      const seedRes = await fetch('/api/pro/image-profiles/seed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brandId }),
      });
      if (seedRes.ok) {
        const data = await seedRes.json();
        setImageProfiles(data.profiles || []);
        resolvedProfileId = data.profiles?.[0]?.id || '';
        if (resolvedProfileId) {
          setImageProfileId(resolvedProfileId);
        }
      }
    }
    if (autoCompose && !resolvedProfileId) {
      setImageError('Seed or select an image profile before composing.');
      setIsBusy(false);
      return;
    }
    if (!resolvedProfileId) {
      setImageError('Select an image profile before composing.');
      return;
    }
    setIsBusy(true);
    setImageError(null);
    const baseAsset = await supabase
      .from('posts')
      .select('base_image_asset_id')
      .eq('id', postId)
      .single();
    const baseAssetId = baseAsset.data?.base_image_asset_id;
    if (!baseAssetId) {
      setIsBusy(false);
      setImageError('Generate a base image before composing.');
      return;
    }
    const res = await fetch('/api/pro/image/compose', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId,
        brandId,
        brandKitId,
        moodBoardId,
        imageProfileId: resolvedProfileId,
        baseAssetId,
        textBlocks: [
          { id: 'label', type: 'label', text: textBlocks.label },
          { id: 'title', type: 'title', text: textBlocks.title },
          { id: 'meta', type: 'meta', text: textBlocks.meta },
          { id: 'cta', type: 'cta', text: textBlocks.cta },
        ],
        logoPlacement,
        logoScale,
        logoPadding,
        bannerStyle,
        bannerColor,
        bannerOpacity,
        overlayOpacity,
        baseTransform: {
          scale: baseScale,
          x: baseOffsetX,
          y: baseOffsetY,
        },
        filters: {
          brightness,
          contrast,
          saturation,
          blur,
        },
        textStyles,
        layoutOverride: layoutOverride || undefined,
      }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setImageError(errorBody.error || 'Failed to compose image.');
      return;
    }
    const data = await res.json();
    setComposedUrl(data.file_url);
  };

  const runCompliance = async () => {
    if (!postId) {
      setPublishError('Generate a post before running compliance.');
      return;
    }
    setIsBusy(true);
    setPublishError(null);
    const res = await fetch('/api/pro/compliance/check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setPublishError(errorBody.error || 'Failed to run compliance checks.');
      return;
    }
    const data = await res.json();
    setCompliance({ status: data.overall_status, checks: data.checks });
  };

  const publishPost = async (publishToLinkedIn: boolean) => {
    if (!postId) {
      setPublishError('Generate a post before publishing.');
      return;
    }
    setIsBusy(true);
    setPublishError(null);
    const res = await fetch('/api/pro/publish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId, publishToLinkedIn }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setPublishError(errorBody.error || 'Failed to publish post.');
      return;
    }
    setCompliance((prev) => prev ?? { status: 'approved', checks: [] });
  };

  const optionReasons = buildOptionReasons();

  return (
    <div className="space-y-6">
      {wizardOpen && (
        <div className="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="w-full max-w-3xl rounded-2xl border border-white/10 bg-[#0b1234] p-6 text-white space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-xs uppercase tracking-widest text-slate-200">Guided Wizard</p>
                <h3 className="text-lg font-semibold">Step {wizardStep + 1} of {wizardSteps.length}</h3>
              </div>
              <Button variant="secondary" onClick={() => setWizardOpen(false)}>
                Close
              </Button>
            </div>
            <div className="grid gap-3 md:grid-cols-2">
              {wizardSteps.map((step, index) => (
                <button
                  key={step.id}
                  type="button"
                  onClick={() => goToWizardStep(index)}
                  className={`rounded-xl border p-3 text-left ${
                    wizardStep === index
                      ? 'border-emerald-400/60 bg-emerald-500/10'
                      : 'border-white/10 bg-white/5'
                  }`}
                >
                  <p className="text-sm font-semibold">{step.title}</p>
                  <p className="text-xs text-slate-200">{step.description}</p>
                </button>
              ))}
            </div>
            <div className="rounded-xl border border-white/10 bg-white/5 p-3">
              <p className="text-sm font-semibold">{wizardSteps[wizardStep]?.title}</p>
              <p className="text-xs text-slate-200">{wizardSteps[wizardStep]?.description}</p>
            </div>
            <div className="flex flex-wrap gap-2">
              <Button
                variant="secondary"
                onClick={() => goToWizardStep(Math.max(0, wizardStep - 1))}
                disabled={wizardStep === 0}
              >
                Back
              </Button>
              <Button
                onClick={() => goToWizardStep(Math.min(wizardSteps.length - 1, wizardStep + 1))}
                disabled={wizardStep === wizardSteps.length - 1}
              >
                Next
              </Button>
              <Button variant="secondary" onClick={() => setActiveTab(wizardSteps[wizardStep]?.tab || 'overview')}>
                Open this step
              </Button>
            </div>
          </div>
        </div>
      )}
      <PageHeader
        eyebrow="Pro Studio"
        title="Human-in-the-loop Marketing Studio"
        subtitle={headerSubtitle}
        actions={
          <Button variant="secondary" className="gap-2" onClick={resetDraft}>
            <Sparkles className="h-4 w-4" />
            Reset
          </Button>
        }
      />

      <Tabs value={activeTab} onValueChange={setActiveTab} className="space-y-6">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div className="flex items-center gap-2">
            <Badge variant="secondary">
              {activeBrand ? `Active brand: ${activeBrand.name}` : 'No brand selected'}
            </Badge>
            <Badge variant="secondary">{studioProgress}% ready</Badge>
          </div>
          {brands.length > 1 && (
            <p className="text-xs text-slate-300">Switch brands in the Brand tab.</p>
          )}
        </div>
        <TabsList className="grid w-full grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-7">
          <TabsTrigger
            value="overview"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Start</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <Sparkles className="h-4 w-4" /> Overview
            </span>
            <span className="text-[11px] text-slate-200">Progress + shortcuts</span>
          </TabsTrigger>
          <TabsTrigger
            value="brand"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 1</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <Palette className="h-4 w-4" /> Brand
            </span>
            <span className="text-[11px] text-slate-200">Kit + voice</span>
          </TabsTrigger>
          <TabsTrigger
            value="mood"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 2</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <Brush className="h-4 w-4" /> Mood
            </span>
            <span className="text-[11px] text-slate-200">Visual direction</span>
          </TabsTrigger>
          <TabsTrigger
            value="profiles"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 3</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <LayoutTemplate className="h-4 w-4" /> Layouts
            </span>
            <span className="text-[11px] text-slate-200">Image profiles</span>
          </TabsTrigger>
          <TabsTrigger
            value="copy"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 4</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <Wand2 className="h-4 w-4" /> Copy
            </span>
            <span className="text-[11px] text-slate-200">Sources + draft</span>
          </TabsTrigger>
          <TabsTrigger
            value="image"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 5</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <ImageIcon className="h-4 w-4" /> Image
            </span>
            <span className="text-[11px] text-slate-200">Generate + compose</span>
          </TabsTrigger>
          <TabsTrigger
            value="publish"
            className="flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-left text-white data-[state=active]:border-white/20 data-[state=active]:bg-white/10"
          >
            <span className="text-[10px] uppercase tracking-widest text-slate-200">Step 6</span>
            <span className="flex items-center gap-2 text-sm font-semibold">
              <Rocket className="h-4 w-4" /> Publish
            </span>
            <span className="text-[11px] text-slate-200">Schedule + approve</span>
          </TabsTrigger>
        </TabsList>

        <TabsContent value="overview" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Studio Overview</h3>
                <p className="text-sm text-slate-200">Track progress from strategy to publishing.</p>
              </div>
              <div className="flex items-center gap-2">
                <Badge variant="secondary">{studioProgress}% ready</Badge>
                <Button variant="secondary" size="sm" onClick={runHealthCheck} disabled={isHealthChecking}>
                  {isHealthChecking ? 'Checking...' : 'Run health check'}
                </Button>
                <Button variant="secondary" size="sm" onClick={openWizard}>
                  Open wizard
                </Button>
              </div>
            </div>
            <div className="h-2 rounded-full bg-white/10 overflow-hidden">
              <div
                className="h-full bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500"
                style={{ width: `${studioProgress}%` }}
              />
            </div>
            <div className="grid gap-3 md:grid-cols-3">
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Active brand</p>
                <p className="text-sm font-semibold text-white">
                  {activeBrand?.name || 'Select a brand'}
                </p>
              </div>
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Current focus</p>
                <p className="text-sm font-semibold text-white">
                  {selectedOption ? 'Refine and publish' : 'Generate copy options'}
                </p>
              </div>
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Compliance</p>
                <p className="text-sm font-semibold text-white">
                  {compliance ? compliance.status.toUpperCase() : 'Not run yet'}
                </p>
              </div>
            </div>
          </Card>
          <Card className="p-6 space-y-3 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">System Status</h3>
                <p className="text-sm text-slate-200">Quick validation of keys, storage, and auth.</p>
              </div>
              <Badge variant="secondary">{healthStatus?.status || 'Not checked'}</Badge>
            </div>
            {healthError && <p className="text-xs text-rose-300">{healthError}</p>}
            {healthStatus?.checks?.length ? (
              <div className="grid gap-2 md:grid-cols-2">
                {healthStatus.checks.map((check) => (
                  <div
                    key={check.name}
                    className="rounded-xl border border-white/10 bg-white/5 p-3 text-sm"
                  >
                    <div className="flex items-center justify-between">
                      <span className="font-semibold">{check.name}</span>
                      <Badge variant="secondary">{check.status}</Badge>
                    </div>
                    {check.detail && <p className="text-xs text-slate-200 mt-1">{check.detail}</p>}
                  </div>
                ))}
              </div>
            ) : (
              <p className="text-xs text-slate-200">Run the health check to verify API readiness.</p>
            )}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Quick Setup</h3>
                <p className="text-sm text-slate-200">
                  Pick an industry preset to prefill the brand kit, identity, and mood board.
                </p>
              </div>
              <Badge variant="secondary">1 minute setup</Badge>
            </div>
            <div className="grid gap-3 md:grid-cols-2">
              {INDUSTRY_PRESETS.map((preset) => (
                <button
                  type="button"
                  key={preset.id}
                  onClick={() => applyIndustryPreset(preset.id)}
                  className={`rounded-xl border p-3 text-left transition ${
                    industryPreset === preset.id
                      ? 'border-emerald-400/60 bg-emerald-500/10'
                      : 'border-white/10 bg-white/5'
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <p className="text-sm font-semibold text-white">{preset.label}</p>
                    <Badge variant="secondary">AI preset</Badge>
                  </div>
                  <p className="text-xs text-slate-200 mt-1">{preset.description}</p>
                  <div className="flex items-center gap-1 mt-2">
                    {[preset.brandKit.primary, preset.brandKit.secondary, preset.brandKit.accent].map((color) => (
                      <span
                        key={color}
                        className="h-3 w-3 rounded-full border border-white/20"
                        style={{ backgroundColor: color }}
                      />
                    ))}
                  </div>
                </button>
              ))}
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Industry preset</label>
                <select
                  value={industryPreset}
                  onChange={(event) => setIndustryPreset(event.target.value)}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {INDUSTRY_PRESETS.map((preset) => (
                    <option key={preset.id} value={preset.id}>
                      {preset.label}
                    </option>
                  ))}
                </select>
              </div>
              <div className="rounded-xl border border-white/10 bg-white/5 p-3 text-sm text-slate-200">
                {INDUSTRY_PRESETS.find((preset) => preset.id === industryPreset)?.description ||
                  'Preset description unavailable.'}
              </div>
            </div>
            <div className="flex flex-wrap gap-2">
              <Button variant="secondary" onClick={() => applyIndustryPreset(industryPreset)} disabled={isBusy}>
                Apply preset
              </Button>
              <Button onClick={runQuickSetup} disabled={isBusy}>
                Quick setup (create all)
              </Button>
            </div>
            {quickSetupError && <p className="text-xs text-rose-300">{quickSetupError}</p>}
            <Separator className="bg-white/10" />
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Templates</p>
                  <p className="text-xs text-slate-200">Save a reusable brand + mood configuration.</p>
                </div>
              </div>
              <div className="flex flex-col gap-2 md:flex-row md:items-center">
                <Input
                  value={templateName}
                  onChange={(event) => setTemplateName(event.target.value)}
                  placeholder="Template name"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <Button variant="secondary" onClick={saveTemplate} disabled={isBusy}>
                  Save template
                </Button>
              </div>
              {templateError && <p className="text-xs text-rose-300">{templateError}</p>}
              {templates.length ? (
                <div className="grid gap-2 md:grid-cols-2">
                  {templates.map((template) => (
                    <div
                      key={template.id}
                      className="rounded-xl border border-white/10 bg-white/5 p-3 flex items-center justify-between"
                    >
                      <div>
                        <img
                          src={templateThumbnail([
                            template.brandKitForm.primary_colors,
                            template.brandKitForm.secondary_colors,
                            template.brandKitForm.accent_colors,
                          ])}
                          alt="Template preview"
                          className="mb-2 h-16 w-full max-w-[220px] rounded-lg border border-white/10 object-cover"
                        />
                        <p className="text-sm font-semibold text-white">{template.name}</p>
                        <p className="text-xs text-slate-200">
                          {template.brandKitForm.name || 'Custom'} + {template.moodBoardForm.name || 'Mood'}
                        </p>
                        <div className="flex items-center gap-1 mt-2">
                          {[template.brandKitForm.primary_colors, template.brandKitForm.secondary_colors, template.brandKitForm.accent_colors]
                            .filter(Boolean)
                            .map((color) => (
                              <span
                                key={color}
                                className="h-3 w-3 rounded-full border border-white/20"
                                style={{ backgroundColor: color }}
                              />
                            ))}
                        </div>
                      </div>
                      <div className="flex gap-2">
                        <Button variant="secondary" size="sm" onClick={() => applyTemplate(template)}>
                          Apply
                        </Button>
                        <Button variant="ghost" size="sm" onClick={() => removeTemplate(template.id)}>
                          Remove
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p className="text-xs text-slate-200">No templates saved yet.</p>
              )}
            </div>
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">AI Wizard</h3>
                <p className="text-sm text-slate-200">
                  One click to draft copy + generate a branded image using your constraints.
                </p>
              </div>
              <Badge variant="secondary">AI assisted</Badge>
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              <div className="space-y-2">
                <label className="text-xs uppercase tracking-widest text-slate-200">Prompt</label>
                <Textarea
                  value={postPrompt}
                  onChange={(event) => setPostPrompt(event.target.value)}
                  placeholder="What do you want to post about?"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Audience</label>
                  <select
                    value={audienceLevel}
                    onChange={(event) =>
                      setAudienceLevel(event.target.value as 'executive' | 'practitioner' | 'general')
                    }
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    {AUDIENCE_LEVELS.map((level) => (
                      <option key={level.value} value={level.value}>
                        {level.label}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Post type</label>
                  <select
                    value={postType}
                    onChange={(event) => setPostType(event.target.value)}
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="">Auto (AI decides)</option>
                    <option value="announcement">Announcement</option>
                    <option value="thought_leadership">Thought leadership</option>
                    <option value="product_update">Product update</option>
                    <option value="case_study">Case study</option>
                    <option value="founder_story">Founder story</option>
                    <option value="hiring">Hiring</option>
                    <option value="event_recap">Event recap</option>
                  </select>
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Length</label>
                  <select
                    value={postLength}
                    onChange={(event) =>
                      setPostLength(event.target.value as 'short' | 'standard' | 'long')
                    }
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="short">Short</option>
                    <option value="standard">Standard</option>
                    <option value="long">Long</option>
                  </select>
                </div>
                <label className="flex items-center gap-2 text-xs text-slate-200">
                  <input
                    type="checkbox"
                    checked={autoCompose}
                    onChange={(event) => setAutoCompose(event.target.checked)}
                  />
                  Auto-generate image + apply logo
                </label>
              </div>
            </div>
            <div className="flex flex-wrap gap-2">
              <Button onClick={runAutoFlow} disabled={isBusy}>
                Make my post (AI)
              </Button>
              <Button variant="secondary" onClick={() => setActiveTab('copy')} disabled={isBusy}>
                Review in Copy tab
              </Button>
              <Button variant="secondary" onClick={() => setActiveTab('image')} disabled={isBusy}>
                Review in Image tab
              </Button>
              <Button
                variant="ghost"
                onClick={() => {
                  setGuidedMode(true);
                  setActiveTab('copy');
                }}
                disabled={isBusy}
              >
                Start guided wizard
              </Button>
            </div>
            {copyError && <p className="text-xs text-rose-300">{copyError}</p>}
            {imageError && <p className="text-xs text-rose-300">{imageError}</p>}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Describe Your Brand (AI)</h3>
                <p className="text-sm text-slate-200">
                  Write a short description and AI will prefill brand kit, identity, and mood board.
                </p>
              </div>
              <Badge variant="secondary">AI setup</Badge>
            </div>
            <Textarea
              value={brandBrief}
              onChange={(event) => setBrandBrief(event.target.value)}
              placeholder="Example: We are a B2B SaaS for sales teams. We want a confident, modern tone with clean visuals and calm colors."
              className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
            />
            <div className="flex flex-wrap gap-2">
              <Button onClick={runBrandBrief} disabled={brandBriefLoading || isBusy}>
                {brandBriefLoading ? 'Generating...' : 'Generate setup (AI)'}
              </Button>
              <Button
                variant="secondary"
                onClick={saveBrandBriefToDatabase}
                disabled={brandBriefSaving || isBusy}
              >
                {brandBriefSaving ? 'Saving...' : 'Save to database'}
              </Button>
              <Button variant="secondary" onClick={() => setActiveTab('brand')} disabled={isBusy}>
                Review in Brand tab
              </Button>
            </div>
            {brandBriefError && <p className="text-xs text-rose-300">{brandBriefError}</p>}
            {brandBriefSaveError && <p className="text-xs text-rose-300">{brandBriefSaveError}</p>}
            {brandBriefSaveSuccess && <p className="text-xs text-emerald-200">{brandBriefSaveSuccess}</p>}
            {brandBriefResult && (
              <div className="rounded-xl border border-white/10 bg-white/5 p-3 text-sm text-slate-200">
                <p className="font-semibold">AI summary</p>
                <p>Kit: {brandBriefResult.brandKitName}</p>
                <p>Tone: {brandBriefResult.tone}</p>
                <p>Mood: {brandBriefResult.mood}</p>
                <p>Audience: {brandBriefResult.audience}</p>
              </div>
            )}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Studio Checklist</h3>
                <p className="text-sm text-slate-200">Work the pipeline step-by-step.</p>
              </div>
              <Badge variant="secondary">{studioSteps.filter((step) => step.done).length} / {studioSteps.length}</Badge>
            </div>
            <div className="grid gap-3 md:grid-cols-2">
              {studioSteps.map((step) => (
                <div
                  key={step.id}
                  className={`rounded-xl border p-3 ${
                    step.done ? 'border-emerald-400/40 bg-emerald-500/10' : 'border-white/10 bg-white/5'
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <span className="text-sm font-semibold">{step.title}</span>
                    <Badge variant="secondary">
                      {step.done ? 'Ready' : step.optional ? 'Optional' : 'Missing'}
                    </Badge>
                  </div>
                  <p className="text-xs text-slate-200">{step.detail}</p>
                  <Button
                    variant="secondary"
                    size="sm"
                    onClick={() => setActiveTab(step.tab)}
                    className="mt-2"
                  >
                    {step.done ? 'Review' : step.optional ? 'Add' : 'Start'}
                  </Button>
                </div>
              ))}
            </div>
          </Card>

          {selectedOption && (
            <Card className="p-6 space-y-3 bg-[#0b1234]/70 border-white/10 text-white">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-lg font-semibold">Selected Draft</h3>
                  <p className="text-sm text-slate-200">This is the current option in review.</p>
                </div>
                <Button variant="secondary" onClick={copySelectedOption} disabled={!postPreview}>
                  Copy draft
                </Button>
              </div>
              <div className="rounded-2xl border border-white/10 bg-white/5 p-4">
                <h4 className="text-base font-semibold">{selectedOption.headline}</h4>
                <p className="text-sm text-slate-200 whitespace-pre-line mt-2">{postPreview}</p>
              </div>
            </Card>
          )}
        </TabsContent>

        <TabsContent value="brand" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Brand Workspace</h3>
                <p className="text-sm text-slate-200">Create a brand and lock a kit before generating content.</p>
              </div>
              <Badge variant="secondary">{brands.length} brands</Badge>
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p className="text-xs uppercase tracking-widest text-slate-300">Active brand</p>
              <p className="mt-1 text-lg font-semibold text-white">
                {activeBrand ? activeBrand.name : 'No brand selected yet'}
              </p>
              <p className="text-xs text-slate-300">
                {activeBrand ? 'Switch brands below or create a new workspace.' : 'Create your first brand workspace to begin.'}
              </p>
            </div>
            <div className="flex flex-col gap-3 lg:flex-row lg:items-end">
              <div className="flex-1">
                <label className="text-xs uppercase tracking-widest text-slate-200">Brand name</label>
                <Input
                  value={brandName}
                  onChange={(event) => setBrandName(event.target.value)}
                  placeholder="e.g. Acme Labs"
                  className="mt-2 bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
              </div>
              <Button onClick={createBrand} disabled={isBusy}>
                Create brand
              </Button>
            </div>
            <div className="flex flex-wrap gap-2">
              {brands.map((brand) => (
                <Button
                  key={brand.id}
                  variant={brand.id === brandId ? 'default' : 'secondary'}
                  onClick={() => selectBrand(brand.id)}
                >
                  {brand.name}
                </Button>
              ))}
            </div>
            {brandError && <p className="text-xs text-rose-300">{brandError}</p>}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Brand Kit</h3>
                <p className="text-sm text-slate-200">Define colors, tone, and visual rules. Lock to enforce.</p>
              </div>
              <div className="flex gap-2">
                <Button variant="secondary" onClick={applyBrandKitDefaults} disabled={isBusy}>
                  Use defaults
                </Button>
                <Button variant="secondary" onClick={suggestBrandKit} disabled={isBusy}>
                  Suggest with AI
                </Button>
                <Button variant="secondary" onClick={lockBrandKit} disabled={isBusy}>
                  Lock kit
                </Button>
              </div>
            </div>
            <Separator className="bg-white/10" />
            <p className="text-xs text-slate-200">
              Tip: hold Ctrl/Cmd to select multiple options in dropdowns.
            </p>
            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Kit name</label>
                <select
                  value={brandKitForm.name}
                  onChange={(event) => setBrandKitForm((prev) => ({ ...prev, name: event.target.value }))}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select kit name</option>
                  {BRAND_KIT_NAMES.map((name) => (
                    <option key={name} value={name}>
                      {name}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Font personality</label>
                <select
                  value={brandKitForm.font_personality}
                  onChange={(event) =>
                    setBrandKitForm((prev) => ({ ...prev, font_personality: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select font personality</option>
                  {FONT_PERSONALITY_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {formatOptionLabel(option)}
                    </option>
                  ))}
                </select>
              </div>
              <div className="md:col-span-2">
                <label className="text-xs uppercase tracking-widest text-slate-200">Palette preset</label>
                <select
                  value={palettePreset}
                  onChange={(event) => {
                    const selected = event.target.value;
                    setPalettePreset(selected);
                    const preset = PALETTE_PRESETS.find((item) => item.id === selected);
                    if (preset) {
                      setBrandKitForm((prev) => ({
                        ...prev,
                        primary_colors: preset.primary,
                        secondary_colors: preset.secondary,
                        accent_colors: preset.accent,
                      }));
                    }
                  }}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Choose a preset palette</option>
                  {PALETTE_PRESETS.map((preset) => (
                    <option key={preset.id} value={preset.id}>
                      {preset.name}
                    </option>
                  ))}
                </select>
              </div>
              <div className="flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-2">
                <span
                  className="h-4 w-4 rounded-full border border-white/20"
                  style={{ backgroundColor: brandKitForm.primary_colors || '#0A66C2' }}
                />
                <select
                  value={brandKitForm.primary_colors}
                  onChange={(event) => setBrandKitForm((prev) => ({ ...prev, primary_colors: event.target.value }))}
                  className="flex-1 bg-transparent text-sm text-white"
                >
                  <option value="">Primary color</option>
                  {COLOR_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <div className="flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-2">
                <span
                  className="h-4 w-4 rounded-full border border-white/20"
                  style={{ backgroundColor: brandKitForm.secondary_colors || '#0F172A' }}
                />
                <select
                  value={brandKitForm.secondary_colors}
                  onChange={(event) => setBrandKitForm((prev) => ({ ...prev, secondary_colors: event.target.value }))}
                  className="flex-1 bg-transparent text-sm text-white"
                >
                  <option value="">Secondary color</option>
                  {COLOR_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <div className="flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-2">
                <span
                  className="h-4 w-4 rounded-full border border-white/20"
                  style={{ backgroundColor: brandKitForm.accent_colors || '#22D3EE' }}
                />
                <select
                  value={brandKitForm.accent_colors}
                  onChange={(event) => setBrandKitForm((prev) => ({ ...prev, accent_colors: event.target.value }))}
                  className="flex-1 bg-transparent text-sm text-white"
                >
                  <option value="">Accent color</option>
                  {COLOR_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Allowed image styles</label>
                <select
                  multiple
                  value={listFromString(brandKitForm.allowed_image_styles)}
                  onChange={(event) =>
                    setBrandKitForm((prev) => ({
                      ...prev,
                      allowed_image_styles: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {IMAGE_STYLE_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {formatOptionLabel(option)}
                    </option>
                  ))}
                </select>
              </div>
              <div className="md:col-span-2">
                <label className="text-xs uppercase tracking-widest text-slate-200">Tone guidelines</label>
                <select
                  multiple
                  value={listFromString(brandKitForm.tone_guidelines)}
                  onChange={(event) =>
                    setBrandKitForm((prev) => ({
                      ...prev,
                      tone_guidelines: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {TONE_GUIDELINE_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {formatOptionLabel(option)}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <Button onClick={createBrandKit} disabled={isBusy}>
              Save brand kit
            </Button>
            {brandKitError && <p className="text-xs text-rose-300">{brandKitError}</p>}
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Brand assets</p>
                  <p className="text-xs text-slate-200">Upload logos for image composition.</p>
                </div>
                <Badge variant="secondary">
                  {activeBrandKit?.logo_assets?.length || 0} logos
                </Badge>
              </div>
              <div className="flex flex-col gap-2 md:flex-row md:items-center">
                <input
                  type="file"
                  accept="image/png,image/jpeg,image/webp,image/svg+xml"
                  onChange={(event) => setLogoFile(event.target.files?.[0] || null)}
                  className="text-sm text-slate-200"
                  disabled={isBusy || Boolean(activeBrandKit?.is_locked)}
                />
                <Button
                  variant="secondary"
                  onClick={uploadLogo}
                  disabled={isBusy || Boolean(activeBrandKit?.is_locked)}
                >
                  Upload logo
                </Button>
              </div>
              {logoError && <p className="text-xs text-rose-300">{logoError}</p>}
              {activeBrandKit?.logo_assets?.length ? (
                <div className="grid gap-3 md:grid-cols-3">
                  {activeBrandKit.logo_assets.map((asset, index) => (
                    <div
                      key={asset.asset_id || asset.url || index}
                      className="rounded-xl border border-white/10 bg-white/5 p-3 space-y-2"
                    >
                      {asset.url && (
                        <img
                          src={asset.url}
                          alt="Logo"
                          className="h-20 w-full object-contain rounded-lg bg-white/5"
                        />
                      )}
                      <div className="flex items-center justify-between text-xs text-slate-200">
                        <span>{index === 0 ? 'Primary' : 'Secondary'}</span>
                        <div className="flex gap-2">
                          <button
                            type="button"
                            className="text-xs text-cyan-200"
                            onClick={() => setPrimaryLogo(asset.asset_id, asset.url)}
                            disabled={index === 0 || isBusy || Boolean(activeBrandKit?.is_locked)}
                          >
                            Set primary
                          </button>
                          <button
                            type="button"
                            className="text-xs text-rose-200"
                            onClick={() => removeLogo(asset.asset_id, asset.url)}
                            disabled={isBusy || Boolean(activeBrandKit?.is_locked)}
                          >
                            Remove
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p className="text-xs text-slate-200">
                  Upload at least one logo to enable branded composition.
                </p>
              )}
            </div>
            <div className="flex flex-wrap gap-2">
              {brandKits.map((kit) => (
                <Button
                  key={kit.id}
                  variant={kit.id === brandKitId ? 'default' : 'secondary'}
                  onClick={() => setBrandKitId(kit.id)}
                >
                  <Palette className="h-4 w-4 mr-2" />
                  {kit.name}
                  {kit.is_locked && (
                    <Badge variant="secondary" className="ml-2">
                      Locked
                    </Badge>
                  )}
                </Button>
              ))}
            </div>
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Marketing Identity</h3>
                <p className="text-sm text-slate-200">Define voice traits, positioning, and guardrails.</p>
              </div>
              <div className="flex gap-2 items-center">
                <Badge variant="secondary">
                  {identityLocked ? 'Locked' : identityId ? 'Draft' : 'New'}
                </Badge>
                <Button
                  variant="secondary"
                  onClick={applyIdentityDefaults}
                  disabled={identityLocked || isBusy}
                >
                  Use defaults
                </Button>
                <Button
                  variant="secondary"
                  onClick={saveIdentity}
                  disabled={identityLocked || isBusy}
                >
                  Save identity
                </Button>
                <Button
                  variant="secondary"
                  onClick={lockIdentity}
                  disabled={identityLocked || isBusy}
                >
                  Lock identity
                </Button>
              </div>
            </div>
            <Separator className="bg-white/10" />
            <p className="text-xs text-slate-200">
              Tip: hold Ctrl/Cmd to select multiple options in dropdowns.
            </p>
            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Positioning</label>
                <select
                  value={identityForm.positioning}
                  onChange={(event) =>
                    setIdentityForm((prev) => ({ ...prev, positioning: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  disabled={!brandId || identityLocked}
                >
                  <option value="">Select positioning</option>
                  {POSITIONING_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Voice traits</label>
                <select
                  multiple
                  value={listFromString(identityForm.voice_traits)}
                  onChange={(event) =>
                    setIdentityForm((prev) => ({
                      ...prev,
                      voice_traits: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  disabled={!brandId || identityLocked}
                >
                  {VOICE_TRAIT_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {formatOptionLabel(option)}
                    </option>
                  ))}
                </select>
              </div>
              <div className="md:col-span-2">
                <label className="text-xs uppercase tracking-widest text-slate-200">Audience personas</label>
                <select
                  multiple
                  value={listFromString(identityForm.audience_personas)}
                  onChange={(event) =>
                    setIdentityForm((prev) => ({
                      ...prev,
                      audience_personas: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  disabled={!brandId || identityLocked}
                >
                  {AUDIENCE_PERSONA_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Preferred phrases</label>
                <select
                  multiple
                  value={listFromString(identityForm.preferred_phrases)}
                  onChange={(event) =>
                    setIdentityForm((prev) => ({
                      ...prev,
                      preferred_phrases: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  disabled={!brandId || identityLocked}
                >
                  {PREFERRED_PHRASE_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Do not use</label>
                <select
                  multiple
                  value={listFromString(identityForm.do_not_use)}
                  onChange={(event) =>
                    setIdentityForm((prev) => ({
                      ...prev,
                      do_not_use: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  disabled={!brandId || identityLocked}
                >
                  {DO_NOT_USE_OPTIONS.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            {identityError && <p className="text-xs text-rose-300">{identityError}</p>}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">LinkedIn Marketing Intelligence</h3>
                <p className="text-sm text-slate-200">Paste 3+ recent posts to analyze tone, cadence, and visuals.</p>
              </div>
              <div className="flex gap-2">
                <Button variant="secondary" onClick={fetchLinkedInPosts} disabled={isBusy}>
                  Fetch from LinkedIn
                </Button>
                <Button variant="secondary" onClick={analyzeLinkedIn} disabled={isBusy}>
                  Analyze posts
                </Button>
              </div>
            </div>
            <Textarea
              value={analysisText}
              onChange={(event) => setAnalysisText(event.target.value)}
              placeholder="Paste LinkedIn posts separated by blank lines."
              className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
            />
            {analysisResult && (
              <div className="grid gap-2 text-sm text-slate-200">
                <div>Tone: {analysisResult.tone}</div>
                <div>Image style: {analysisResult.image_style}</div>
                <div>CTA style: {analysisResult.cta_style}</div>
                <div>Visual density: {analysisResult.visual_density}</div>
                {analysisResult.product_mentions?.length ? (
                  <div>Products: {analysisResult.product_mentions.join(', ')}</div>
                ) : null}
                {analysisResult.content_pillars?.length ? (
                  <div>Content pillars: {analysisResult.content_pillars.join(', ')}</div>
                ) : null}
              </div>
            )}
          </Card>
        </TabsContent>

        <TabsContent value="mood" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Mood Board</h3>
                <p className="text-sm text-slate-200">Set the visual and emotional context. Lock to enforce.</p>
              </div>
              <div className="flex gap-2">
                <Button variant="secondary" onClick={applyMoodBoardDefaults} disabled={isBusy}>
                  Use defaults
                </Button>
                <Button variant="secondary" onClick={suggestMoodBoard} disabled={isBusy}>
                  Suggest with AI
                </Button>
                <Button variant="secondary" onClick={lockMoodBoard} disabled={isBusy}>
                  Lock board
                </Button>
              </div>
            </div>
            <Separator className="bg-white/10" />
            <p className="text-xs text-slate-200">
              Tip: hold Ctrl/Cmd to select multiple options in dropdowns.
            </p>
            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Mood board name</label>
                <select
                  value={moodBoardForm.name}
                  onChange={(event) => setMoodBoardForm((prev) => ({ ...prev, name: event.target.value }))}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select mood board</option>
                  {MOOD_BOARD_NAMES.map((name) => (
                    <option key={name} value={name}>
                      {name}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Palette colors</label>
                <select
                  multiple
                  value={listFromString(moodBoardForm.palette_colors)}
                  onChange={(event) =>
                    setMoodBoardForm((prev) => ({
                      ...prev,
                      palette_colors: selectedValuesFromEvent(event).join(', '),
                    }))
                  }
                  className="mt-2 h-28 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {COLOR_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Typography mood</label>
                <select
                  value={moodBoardForm.typography_mood}
                  onChange={(event) =>
                    setMoodBoardForm((prev) => ({ ...prev, typography_mood: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select typography mood</option>
                  {TYPOGRAPHY_MOODS.map((option) => (
                    <option key={option} value={option}>
                      {formatOptionLabel(option)}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Image density</label>
                <select
                  value={moodBoardForm.image_density}
                  onChange={(event) =>
                    setMoodBoardForm((prev) => ({ ...prev, image_density: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select density</option>
                  {IMAGE_DENSITIES.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Composition style</label>
                <select
                  value={moodBoardForm.composition_style}
                  onChange={(event) =>
                    setMoodBoardForm((prev) => ({ ...prev, composition_style: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select composition</option>
                  {COMPOSITION_STYLES.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Emotional tone</label>
                <select
                  value={moodBoardForm.emotional_tone}
                  onChange={(event) =>
                    setMoodBoardForm((prev) => ({ ...prev, emotional_tone: event.target.value }))
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Select tone</option>
                  {EMOTIONAL_TONES.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <Button onClick={createMoodBoard} disabled={isBusy}>
              Save mood board
            </Button>
            {moodError && <p className="text-xs text-rose-300">{moodError}</p>}
            <div className="flex flex-wrap gap-2">
              {moodBoards.map((mood) => (
                <Button
                  key={mood.id}
                  variant={mood.id === moodBoardId ? 'default' : 'secondary'}
                  onClick={() => setMoodBoardId(mood.id)}
                >
                  {mood.name}
                  {mood.is_locked && (
                    <Badge variant="secondary" className="ml-2">
                      Locked
                    </Badge>
                  )}
                </Button>
              ))}
            </div>
          </Card>
        </TabsContent>

        <TabsContent value="profiles" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-lg font-semibold">Image Profiles</h3>
                <p className="text-sm text-slate-200">Choose templated layouts for deterministic composition.</p>
              </div>
              <Button variant="secondary" onClick={seedProfiles} disabled={isBusy}>
                Seed defaults
              </Button>
            </div>
            {profileError && <p className="text-xs text-rose-300">{profileError}</p>}
            <div className="flex flex-wrap gap-2">
              {imageProfiles.map((profile) => (
                <Button
                  key={profile.id}
                  variant={profile.id === imageProfileId ? 'default' : 'secondary'}
                  onClick={() => setImageProfileId(profile.id)}
                >
                  <LayoutTemplate className="h-4 w-4 mr-2" />
                  {profile.name}
                </Button>
              ))}
            </div>
          </Card>
        </TabsContent>

        <TabsContent value="copy" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <div className="flex items-center justify-between">
              <h3 className="text-lg font-semibold flex items-center gap-2">
                <Wand2 className="h-5 w-5" /> Create Copy
              </h3>
              <Button variant="secondary" size="sm" onClick={() => setGuidedMode((prev) => !prev)}>
                {guidedMode ? 'Show all settings' : 'Guided mode'}
              </Button>
            </div>
            <p className="text-sm text-slate-200">
              Follow the steps below to craft a post quickly. Toggle guided mode to simplify the view.
            </p>
            <div className="grid gap-3 md:grid-cols-3">
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Step 1</p>
                <p className="text-sm font-semibold">Pick audience + format</p>
                <p className="text-xs text-slate-200">Set tone and length.</p>
              </div>
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Step 2</p>
                <p className="text-sm font-semibold">Add your prompt</p>
                <p className="text-xs text-slate-200">Describe what to post.</p>
              </div>
              <div className="rounded-xl border border-white/10 bg-white/5 p-3">
                <p className="text-xs uppercase tracking-widest text-slate-200">Step 3</p>
                <p className="text-sm font-semibold">Generate options</p>
                <p className="text-xs text-slate-200">Pick the best one.</p>
              </div>
            </div>
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Content sources (optional)</p>
                  <p className="text-xs text-slate-200">Add URLs or product pages to ground the copy in facts.</p>
                </div>
                <div className="text-xs text-slate-200">Selected: {selectedSourceIds.length}</div>
              </div>
              {!guidedMode && (
                <div className="flex flex-col gap-2 md:flex-row">
                  <Input
                    value={sourceUrl}
                    onChange={(event) => setSourceUrl(event.target.value)}
                    placeholder="https://example.com/product-page"
                    className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                  />
                  <select
                    value={sourceType}
                    onChange={(event) => setSourceType(event.target.value as typeof sourceType)}
                    className="rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="url">Website</option>
                    <option value="product">Product</option>
                    <option value="document">Document</option>
                    <option value="manual">Manual</option>
                  </select>
                  <Button onClick={ingestSource} disabled={isBusy}>
                    Ingest source
                  </Button>
                </div>
              )}
              {sourceError && <p className="text-xs text-rose-300">{sourceError}</p>}
              {!guidedMode && sources.length ? (
                <div className="grid gap-2 md:grid-cols-2">
                  {sources.map((source) => {
                    const selected = selectedSourceIds.includes(source.id);
                    const label = source.title || source.source_url;
                    return (
                      <button
                        type="button"
                        key={source.id}
                        onClick={() => toggleSource(source.id)}
                        className={`rounded-xl border p-3 text-left transition ${
                          selected ? 'border-emerald-400/60 bg-emerald-500/10' : 'border-white/10 bg-white/5'
                        }`}
                        aria-pressed={selected}
                      >
                        <div className="flex items-center justify-between gap-2">
                          <span className="text-sm font-semibold">{label}</span>
                          <Badge variant="secondary">{source.source_type || 'url'}</Badge>
                        </div>
                        <p className="text-xs text-slate-200 break-all">{source.source_url}</p>
                        {source.content_excerpt && (
                          <p className="text-xs text-slate-200">{shorten(source.content_excerpt, 140)}</p>
                        )}
                      </button>
                    );
                  })}
                </div>
              ) : !guidedMode ? (
                <p className="text-xs text-slate-200">No sources yet. Add a URL to ground the copy.</p>
              ) : null}
              {!guidedMode && selectedSourceIds.length > 0 && (
                <Button variant="secondary" onClick={() => setSelectedSourceIds([])}>
                  Clear selection
                </Button>
              )}
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div>
                <p className="text-sm font-semibold text-slate-200">Post strategy</p>
                <p className="text-xs text-slate-200">Guide the format and length of the copy.</p>
              </div>
              <div className="grid gap-3 md:grid-cols-3">
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Post type</label>
                  <select
                    value={postType}
                    onChange={(event) => setPostType(event.target.value)}
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="">Auto (AI decides)</option>
                    <option value="announcement">Announcement</option>
                    <option value="thought_leadership">Thought leadership</option>
                    <option value="product_update">Product update</option>
                    <option value="case_study">Case study</option>
                    <option value="founder_story">Founder story</option>
                    <option value="hiring">Hiring</option>
                    <option value="event_recap">Event recap</option>
                  </select>
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Length</label>
                  <select
                    value={postLength}
                    onChange={(event) =>
                      setPostLength(event.target.value as 'short' | 'standard' | 'long')
                    }
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="short">Short</option>
                    <option value="standard">Standard</option>
                    <option value="long">Long</option>
                  </select>
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Audience focus</label>
                  <select
                    value={audienceLevel}
                    onChange={(event) =>
                      setAudienceLevel(event.target.value as 'executive' | 'practitioner' | 'general')
                    }
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    {AUDIENCE_LEVELS.map((level) => (
                      <option key={level.value} value={level.value}>
                        {level.label}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            </div>
            <label className="flex items-center gap-2 text-xs text-slate-200">
              <input
                type="checkbox"
                checked={autoCompose}
                onChange={(event) => setAutoCompose(event.target.checked)}
              />
              Auto-generate image after copy (AI)
            </label>
            {!guidedMode && (
              <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Prompt template</p>
                  <p className="text-xs text-slate-200">Pick a template or write your own prompt.</p>
                </div>
                <select
                  value={postPromptTemplate}
                  onChange={(event) => {
                    const selected = event.target.value;
                    setPostPromptTemplate(selected);
                    const template = POST_PROMPT_TEMPLATES.find((item) => item.id === selected);
                    if (template) {
                      setPostPrompt(template.prompt);
                    }
                  }}
                  className="w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="">Custom prompt</option>
                  {POST_PROMPT_TEMPLATES.map((template) => (
                    <option key={template.id} value={template.id}>
                      {template.label}
                    </option>
                  ))}
                </select>
              </div>
            )}
            <Textarea
              value={postPrompt}
              onChange={(event) => setPostPrompt(event.target.value)}
              placeholder="Describe the post you want to publish."
              className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
            />
            {(promptGuardrails.length > 0 || (selectedOption && missingPreferredPhrases.length > 0)) && (
              <div className="rounded-xl border border-rose-400/40 bg-rose-500/10 p-3 text-sm text-rose-100 space-y-2">
                <p className="font-semibold">Brand guardrails</p>
                {promptGuardrails.length > 0 && (
                  <p className="text-xs text-rose-100/90">
                    Remove these banned phrases from your prompt: {promptGuardrails.join(', ')}.
                  </p>
                )}
                {selectedOption && missingPreferredPhrases.length > 0 && (
                  <p className="text-xs text-rose-100/90">
                    Consider adding a preferred phrase: {missingPreferredPhrases.slice(0, 3).join(', ')}.
                  </p>
                )}
              </div>
            )}
            <Button onClick={generateOptions} disabled={isBusy}>
              Generate options
            </Button>
            {autoCompose && (
              <Button variant="secondary" onClick={runAutoFlow} disabled={isBusy}>
                Generate + image (AI)
              </Button>
            )}
            {copyError && <p className="text-xs text-rose-300">{copyError}</p>}
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Live preview</p>
                  <p className="text-xs text-slate-200">Preview your copy with brand colors and logo.</p>
                </div>
                <div className="flex items-center gap-1">
                  {[brandKitForm.primary_colors || '#0A66C2', brandKitForm.secondary_colors || '#0F172A', brandKitForm.accent_colors || '#22D3EE'].map(
                    (color) => (
                      <span
                        key={color}
                        className="h-3 w-3 rounded-full border border-white/20"
                        style={{ backgroundColor: color }}
                      />
                    )
                  )}
                </div>
              </div>
              <div className="rounded-xl border border-white/10 bg-[#0b1234]/70 p-4 flex items-start gap-3">
                {activeBrandKit?.logo_assets?.[0]?.url ? (
                  <img
                    src={activeBrandKit.logo_assets[0].url}
                    alt="Logo"
                    className="h-10 w-10 rounded-md bg-white/5 object-contain"
                  />
                ) : (
                  <div className="h-10 w-10 rounded-md bg-white/5 flex items-center justify-center text-[10px] text-slate-200">
                    Logo
                  </div>
                )}
                <div>
                  <p className="text-sm font-semibold text-white">{livePreviewHeadline}</p>
                  <p className="text-xs text-slate-200 mt-1">{livePreviewBody}</p>
                </div>
              </div>
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              {postOptions.map((option, index) => (
                <Card key={index} className="p-4 bg-white/5 border-white/10 text-white space-y-2">
                  <h4 className="font-semibold">{option.headline}</h4>
                  {option.hook && (
                    <p className="text-sm text-slate-100 font-medium">{option.hook}</p>
                  )}
                  <p className="text-sm text-slate-200 whitespace-pre-line">{option.body}</p>
                  <p className="text-sm text-slate-200">CTA: {option.cta}</p>
                  <div className="flex flex-wrap gap-1">
                    {(option.hashtags || []).map((tag: string) => (
                      <Badge key={tag} variant="secondary">{tag}</Badge>
                    ))}
                  </div>
                  {option.risk_flags?.length ? (
                    <div className="flex flex-wrap gap-1">
                      {option.risk_flags.map((flag) => (
                        <Badge key={flag} variant="secondary">{flag}</Badge>
                      ))}
                    </div>
                  ) : null}
                  {option.notes && (
                    <p className="text-xs text-slate-200">{option.notes}</p>
                  )}
                  {optionReasons.length > 0 && (
                    <div className="text-xs text-slate-200 space-y-1">
                      <p className="font-semibold text-slate-200">Why this option</p>
                      {optionReasons.map((reason) => (
                        <p key={reason}>- {reason}</p>
                      ))}
                    </div>
                  )}
                  <Button variant="secondary" onClick={() => selectOption(index)} disabled={isBusy}>
                    Use this option
                  </Button>
                </Card>
              ))}
            </div>
            {selectedOption && (
              <Card className="p-4 bg-white/5 border-white/10 text-white space-y-2">
                <div className="flex items-center justify-between">
                  <h4 className="font-semibold">Selected option</h4>
                  <Button variant="secondary" size="sm" onClick={copySelectedOption} disabled={!postPreview}>
                    Copy text
                  </Button>
                </div>
                <p className="text-xs text-slate-200">Headline</p>
                <p className="text-sm text-slate-200">{selectedOption.headline}</p>
                <p className="text-xs text-slate-200">Preview</p>
                <p className="text-sm text-slate-200 whitespace-pre-line">{postPreview}</p>
                {previewGuardrails.length > 0 && (
                  <div className="rounded-lg border border-rose-400/40 bg-rose-500/10 p-2 text-xs text-rose-100">
                    Remove banned phrases: {previewGuardrails.join(', ')}.
                  </div>
                )}
              </Card>
            )}

            {!guidedMode && (
              <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm font-semibold text-slate-200">Batch mode</p>
                    <p className="text-xs text-slate-200">Generate multiple posts at once (one topic per line).</p>
                  </div>
                  <Badge variant="secondary">Up to 6 topics</Badge>
                </div>
                <Textarea
                  value={batchPrompts}
                  onChange={(event) => setBatchPrompts(event.target.value)}
                  placeholder="Example:\nLaunch announcement\nCustomer story\nHiring update"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <Button variant="secondary" onClick={runBatchGeneration} disabled={isBatching || isBusy}>
                  {isBatching ? 'Generating batch...' : 'Generate batch'}
                </Button>
                {batchError && <p className="text-xs text-rose-300">{batchError}</p>}
              {batchRuns.length > 0 && (
                <div className="grid gap-2 md:grid-cols-2">
                  {batchRuns.map((run) => (
                    <div key={run.id} className="rounded-xl border border-white/10 bg-white/5 p-3 space-y-2">
                      <p className="text-sm font-semibold text-white">{run.prompt}</p>
                      <p className="text-xs text-slate-200">{run.options.length} options generated</p>
                      <Button variant="secondary" size="sm" onClick={() => loadBatchRun(run)}>
                        Open this batch
                      </Button>
                    </div>
                  ))}
                </div>
              )}
            </div>
            )}
          </Card>
        </TabsContent>

        <TabsContent value="image" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <h3 className="text-lg font-semibold flex items-center gap-2">
              <ImageIcon className="h-5 w-5" /> Image Generation & Composition
            </h3>
            <div className="grid gap-3 md:grid-cols-4">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Image size</label>
                <select
                  value={imageSize}
                  onChange={(event) => setImageSize(event.target.value)}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="1200x628">1200x628 (LinkedIn)</option>
                  <option value="1080x1080">1080x1080 (Square)</option>
                  <option value="1920x1080">1920x1080 (Wide)</option>
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Quality</label>
                <select
                  value={imageQuality}
                  onChange={(event) =>
                    setImageQuality(event.target.value as 'low' | 'medium' | 'high')
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Format</label>
                <select
                  value={imageFormat}
                  onChange={(event) =>
                    setImageFormat(event.target.value as 'png' | 'jpeg' | 'webp')
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="png">PNG</option>
                  <option value="jpeg">JPEG</option>
                  <option value="webp">WEBP</option>
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Logo placement</label>
                <select
                  value={logoPlacement}
                  onChange={(event) =>
                    setLogoPlacement(
                      event.target.value as 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center'
                    )
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {LOGO_PLACEMENTS.map((placement) => (
                    <option key={placement.value} value={placement.value}>
                      {placement.label}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <div className="grid gap-3 md:grid-cols-3">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Banner style</label>
                <select
                  value={bannerStyle}
                  onChange={(event) =>
                    setBannerStyle(event.target.value as 'none' | 'top' | 'bottom' | 'full')
                  }
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  <option value="none">None</option>
                  <option value="top">Top band</option>
                  <option value="bottom">Bottom band</option>
                  <option value="full">Full overlay</option>
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">Banner color</label>
                <select
                  value={bannerColor}
                  onChange={(event) => setBannerColor(event.target.value)}
                  className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                >
                  {COLOR_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Banner opacity ({bannerOpacity.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={0}
                  max={1}
                  step={0.05}
                  value={bannerOpacity}
                  onChange={(event) => setBannerOpacity(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Logo scale ({logoScale.toFixed(2)}x)
                </label>
                <input
                  type="range"
                  min={0.6}
                  max={1.6}
                  step={0.05}
                  value={logoScale}
                  onChange={(event) => setLogoScale(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Logo padding ({logoPadding}px)
                </label>
                <input
                  type="range"
                  min={0}
                  max={24}
                  step={2}
                  value={logoPadding}
                  onChange={(event) => setLogoPadding(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Overlay intensity ({overlayOpacity.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={0}
                  max={0.4}
                  step={0.02}
                  value={overlayOpacity}
                  onChange={(event) => setOverlayOpacity(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
            </div>
            <div className="grid gap-3 md:grid-cols-3">
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Base zoom ({baseScale.toFixed(2)}x)
                </label>
                <input
                  type="range"
                  min={0.8}
                  max={1.6}
                  step={0.05}
                  value={baseScale}
                  onChange={(event) => setBaseScale(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Base X ({baseOffsetX.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={-0.3}
                  max={0.3}
                  step={0.02}
                  value={baseOffsetX}
                  onChange={(event) => setBaseOffsetX(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Base Y ({baseOffsetY.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={-0.3}
                  max={0.3}
                  step={0.02}
                  value={baseOffsetY}
                  onChange={(event) => setBaseOffsetY(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Brightness ({brightness.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={0.7}
                  max={1.3}
                  step={0.05}
                  value={brightness}
                  onChange={(event) => setBrightness(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Contrast ({contrast.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={0.7}
                  max={1.3}
                  step={0.05}
                  value={contrast}
                  onChange={(event) => setContrast(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Saturation ({saturation.toFixed(2)})
                </label>
                <input
                  type="range"
                  min={0.7}
                  max={1.4}
                  step={0.05}
                  value={saturation}
                  onChange={(event) => setSaturation(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div>
                <label className="text-xs uppercase tracking-widest text-slate-200">
                  Blur ({blur.toFixed(1)}px)
                </label>
                <input
                  type="range"
                  min={0}
                  max={2}
                  step={0.2}
                  value={blur}
                  onChange={(event) => setBlur(Number(event.target.value))}
                  className="mt-3 w-full"
                />
              </div>
              <div className="flex items-end">
                <Button variant="secondary" onClick={resetImageAdjustments} disabled={isBusy}>
                  Reset image edits
                </Button>
              </div>
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div>
                <p className="text-sm font-semibold text-slate-200">Image prompt template</p>
                <p className="text-xs text-slate-200">Pick a starter prompt or write your own.</p>
              </div>
              <select
                value={imagePromptTemplate}
                onChange={(event) => {
                  const selected = event.target.value;
                  setImagePromptTemplate(selected);
                  const template = IMAGE_PROMPT_TEMPLATES.find((item) => item.id === selected);
                  if (template) {
                    setBasePrompt(template.prompt);
                  }
                }}
                className="w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
              >
                <option value="">Custom prompt</option>
                {IMAGE_PROMPT_TEMPLATES.map((template) => (
                  <option key={template.id} value={template.id}>
                    {template.label}
                  </option>
                ))}
              </select>
            </div>
            <Textarea
              value={basePrompt}
              onChange={(event) => setBasePrompt(event.target.value)}
              placeholder="Describe the image you need (base image only, no text/logos)."
              className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
            />
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div>
                <p className="text-sm font-semibold text-slate-200">Style reference (AI)</p>
                <p className="text-xs text-slate-200">
                  Add a reference image and let AI extract a style guide + palette.
                </p>
              </div>
              <div className="flex flex-col gap-2 md:flex-row">
                <Input
                  value={styleReferenceUrl}
                  onChange={(event) => setStyleReferenceUrl(event.target.value)}
                  placeholder="https://example.com/style-reference.jpg"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <Button variant="secondary" onClick={analyzeStyleReference} disabled={isStyleLoading}>
                  {isStyleLoading ? 'Analyzing...' : 'Analyze style'}
                </Button>
              </div>
              <div className="flex flex-col gap-2 md:flex-row">
                <Input
                  type="file"
                  accept="image/*"
                  onChange={(event) => setUploadRefFile(event.target.files?.[0] || null)}
                  className="bg-white/5 border-white/10 text-white file:text-slate-200"
                />
                <Button variant="secondary" onClick={uploadReferenceFile} disabled={isStyleLoading}>
                  Upload reference
                </Button>
              </div>
              {styleSummary && (
                <p className="text-xs text-slate-200">Style notes: {styleSummary}</p>
              )}
              {stylePalette.length > 0 && (
                <div className="flex flex-wrap gap-2">
                  {stylePalette.map((color) => (
                    <span key={color} className="inline-flex items-center gap-2 text-xs text-slate-200">
                      <span className="h-3 w-3 rounded-full border border-white/20" style={{ backgroundColor: color }} />
                      {color}
                    </span>
                  ))}
                </div>
              )}
              {stylePalette.length > 0 && (
                <Button
                  variant="secondary"
                  size="sm"
                  onClick={() => setBannerColor(stylePalette[0])}
                >
                  Use palette for banner
                </Button>
              )}
              {styleError && <p className="text-xs text-rose-300">{styleError}</p>}
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-2">
              <p className="text-sm font-semibold text-slate-200">Use your own base image</p>
              <p className="text-xs text-slate-200">
                Paste a hosted image URL to use instead of AI generation.
              </p>
              <div className="flex flex-col gap-2 md:flex-row">
                <Input
                  value={customBaseUrl}
                  onChange={(event) => setCustomBaseUrl(event.target.value)}
                  placeholder="https://example.com/your-image.png"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <Button variant="secondary" onClick={registerBaseImageFromUrl} disabled={isBusy}>
                  Use image URL
                </Button>
              </div>
              <div className="flex flex-col gap-2 md:flex-row">
                <Input
                  type="file"
                  accept="image/*"
                  onChange={(event) => setUploadBaseFile(event.target.files?.[0] || null)}
                  className="bg-white/5 border-white/10 text-white file:text-slate-200"
                />
                <Button variant="secondary" onClick={uploadBaseImageFile} disabled={isBusy}>
                  Upload base image
                </Button>
              </div>
              {uploadBaseError && <p className="text-xs text-rose-300">{uploadBaseError}</p>}
              {customBaseError && <p className="text-xs text-rose-300">{customBaseError}</p>}
            </div>
            <Button onClick={generateBaseImage} disabled={isBusy}>
              Generate base image
            </Button>
            <Button variant="secondary" onClick={generateVariations} disabled={isBusy}>
              Generate 4 variations
            </Button>
            <Button
              variant="secondary"
              onClick={async () => {
                if (!postId || !brandId) {
                  setImageError('Generate a post before exporting.');
                  return;
                }
                const res = await fetch('/api/pro/image/export-pack', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ postId, brandId }),
                });
                if (!res.ok) {
                  const errorBody = await res.json().catch(() => ({}));
                  setImageError(errorBody.error || 'Failed to export pack.');
                  return;
                }
                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `image-pack-${postId}.zip`;
                link.click();
                URL.revokeObjectURL(url);
              }}
              disabled={isBusy}
            >
              Download pack (zip)
            </Button>
            {imageError && <p className="text-xs text-rose-300">{imageError}</p>}
            {baseImageUrl && (
              <img src={baseImageUrl} alt="Base" className="w-full rounded-2xl border border-white/10" />
            )}
            {baseVariations.length > 0 && (
              <div className="grid gap-3 md:grid-cols-4">
                {baseVariations.map((variation) => (
                  <button
                    key={variation.id}
                    type="button"
                    onClick={() => selectVariation(variation)}
                    className="group rounded-xl border border-white/10 bg-white/5 p-2 text-left hover:border-cyan-400/60"
                  >
                    <img
                      src={variation.url}
                      alt="Variation"
                      className="w-full rounded-lg border border-white/10"
                    />
                    <p className="mt-2 text-xs text-slate-200">Use this base</p>
                  </button>
                ))}
              </div>
            )}
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div>
                <p className="text-sm font-semibold text-slate-200">AI edit (inpainting)</p>
                <p className="text-xs text-slate-200">
                  Paint over the areas you want to change, then describe the edit.
                </p>
              </div>
              <div className="grid gap-3 md:grid-cols-3">
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">
                    Brush size ({brushSize}px)
                  </label>
                  <input
                    type="range"
                    min={8}
                    max={80}
                    step={2}
                    value={brushSize}
                    onChange={(event) => setBrushSize(Number(event.target.value))}
                    className="mt-3 w-full"
                  />
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Mode</label>
                  <div className="mt-2 flex gap-2">
                    <Button
                      variant={maskMode === 'paint' ? 'default' : 'secondary'}
                      size="sm"
                      onClick={() => setMaskMode('paint')}
                    >
                      Paint
                    </Button>
                    <Button
                      variant={maskMode === 'erase' ? 'default' : 'secondary'}
                      size="sm"
                      onClick={() => setMaskMode('erase')}
                    >
                      Erase
                    </Button>
                  </div>
                </div>
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Tool</label>
                  <div className="mt-2 flex flex-wrap gap-2">
                    {(['brush', 'rect', 'circle', 'line'] as const).map((tool) => (
                      <Button
                        key={tool}
                        variant={maskTool === tool ? 'default' : 'secondary'}
                        size="sm"
                        onClick={() => setMaskTool(tool)}
                      >
                        {tool}
                      </Button>
                    ))}
                  </div>
                </div>
                <div className="flex items-end">
                  <Button variant="secondary" onClick={clearMask} size="sm">
                    Clear mask
                  </Button>
                </div>
              </div>
              <div className="relative aspect-[1200/628] w-full overflow-hidden rounded-xl border border-white/10 bg-[#060b22]">
                {baseImageUrl ? (
                  <>
                    <img src={baseImageUrl} alt="Base" className="absolute inset-0 h-full w-full object-cover" />
                    <canvas
                      ref={maskCanvasRef}
                      onPointerDown={handleMaskPointerDown}
                      onPointerMove={handleMaskPointerMove}
                      onPointerUp={handleMaskPointerUp}
                      onPointerLeave={handleMaskPointerUp}
                      className="absolute inset-0 h-full w-full cursor-crosshair"
                      style={{ mixBlendMode: 'screen' }}
                    />
                  </>
                ) : (
                  <div className="flex h-full items-center justify-center text-sm text-slate-300">
                    Generate a base image first to edit.
                  </div>
                )}
              </div>
              <Textarea
                value={editPrompt}
                onChange={(event) => setEditPrompt(event.target.value)}
                placeholder="Example: Replace the sky with a warm sunset, keep the product in focus."
                className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
              />
              <div className="flex flex-wrap gap-2">
                <Button onClick={generateEdit} disabled={isEditing || isBusy}>
                  {isEditing ? 'Editing...' : 'Generate edit'}
                </Button>
                {editError && <p className="text-xs text-rose-300">{editError}</p>}
              </div>
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Layout editor (drag)</p>
                  <p className="text-xs text-slate-200">Move logo and text zones visually.</p>
                </div>
                <div className="flex items-center gap-2">
                  <label className="text-xs text-slate-200">Manual layout</label>
                  <input
                    type="checkbox"
                    checked={manualLayout}
                    onChange={(event) => setManualLayout(event.target.checked)}
                  />
                </div>
              </div>
              <div
                ref={previewRef}
                onPointerMove={handlePreviewMove}
                onPointerUp={stopDragging}
                onPointerLeave={stopDragging}
                className="relative aspect-[1200/628] w-full overflow-hidden rounded-xl border border-white/10 bg-[#060b22]"
                style={{
                  backgroundImage: baseImageUrl ? `url(${baseImageUrl})` : undefined,
                  backgroundSize: `${baseScale * 100}%`,
                  backgroundPosition: `${50 + baseOffsetX * 100}% ${50 + baseOffsetY * 100}%`,
                }}
              >
                {layoutPreviewZones.map((zone) => (
                  <div
                    key={zone.id}
                    role="button"
                    tabIndex={0}
                    onPointerDown={startDragZone(zone.id)}
                    className={`absolute border border-cyan-400/80 bg-cyan-400/10 text-[10px] uppercase tracking-widest text-cyan-100 ${manualLayout ? 'cursor-move' : 'cursor-not-allowed'}`}
                    style={{
                      left: `${zone.x * 100}%`,
                      top: `${zone.y * 100}%`,
                      width: `${zone.w * 100}%`,
                      height: `${zone.h * 100}%`,
                    }}
                  >
                    <span className="ml-2 mt-1 inline-block">{zone.id}</span>
                  </div>
                ))}
              </div>
              <div className="flex justify-between text-xs text-slate-200">
                <span>Drag zones only when manual layout is enabled.</span>
                <div className="flex items-center gap-2">
                  <Input
                    value={layoutProfileName}
                    onChange={(event) => setLayoutProfileName(event.target.value)}
                    placeholder="Layout name"
                    className="h-8 w-40 bg-white/5 border-white/10 text-xs text-white placeholder:text-slate-500"
                  />
                  <Button variant="secondary" size="sm" onClick={saveLayoutProfile} disabled={isBusy}>
                    Save layout
                  </Button>
                  <Button variant="secondary" size="sm" onClick={resetLayout}>
                    Reset layout
                  </Button>
                </div>
              </div>
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-slate-200">Image presets</p>
                  <p className="text-xs text-slate-200">Save and reuse your full image styling.</p>
                </div>
              </div>
              <div className="flex flex-col gap-2 md:flex-row">
                <Input
                  value={imagePresetName}
                  onChange={(event) => setImagePresetName(event.target.value)}
                  placeholder="Preset name"
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <Button variant="secondary" onClick={saveImagePreset}>
                  Save preset
                </Button>
              </div>
              {imagePresets.length > 0 && (
                <div className="grid gap-2 md:grid-cols-2">
                  {imagePresets.map((preset) => (
                    <div key={preset.id} className="rounded-xl border border-white/10 bg-white/5 p-3">
                      <p className="text-sm text-white">{preset.name}</p>
                      <div className="mt-2 flex gap-2">
                        <Button variant="secondary" size="sm" onClick={() => applyImagePreset(preset)}>
                          Apply
                        </Button>
                        <Button variant="secondary" size="sm" onClick={() => removeImagePreset(preset.id)}>
                          Remove
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <Separator className="bg-white/10" />
            <div className="flex items-center justify-between">
              <p className="text-sm text-slate-200">Text overlays (optional)</p>
              <Button
                variant="secondary"
                size="sm"
                onClick={applySelectedOptionToTextBlocks}
                disabled={!selectedOption}
              >
                Use selected option
              </Button>
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              <Input
                value={textBlocks.label}
                onChange={(event) => setTextBlocks((prev) => ({ ...prev, label: event.target.value }))}
                placeholder="Label text"
                className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
              />
              <Input
                value={textBlocks.title}
                onChange={(event) => setTextBlocks((prev) => ({ ...prev, title: event.target.value }))}
                placeholder="Headline"
                className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
              />
              <Input
                value={textBlocks.meta}
                onChange={(event) => setTextBlocks((prev) => ({ ...prev, meta: event.target.value }))}
                placeholder="Meta line"
                className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
              />
              <Input
                value={textBlocks.cta}
                onChange={(event) => setTextBlocks((prev) => ({ ...prev, cta: event.target.value }))}
                placeholder="CTA"
                className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
              />
            </div>
            <div className="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
              <p className="text-sm font-semibold text-slate-200">Text styling</p>
              <div className="grid gap-3 md:grid-cols-2">
                {(['label', 'title', 'meta', 'cta'] as const).map((key) => (
                  <div key={key} className="rounded-xl border border-white/10 bg-white/5 p-3 space-y-2">
                    <p className="text-xs uppercase tracking-widest text-slate-200">{key}</p>
                    <div>
                      <label className="text-xs text-slate-300">Color</label>
                      <select
                        value={textStyles[key]?.color || '#FFFFFF'}
                        onChange={(event) =>
                          setTextStyles((prev) => ({
                            ...prev,
                            [key]: { ...prev[key], color: event.target.value },
                          }))
                        }
                        className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                      >
                        {COLOR_OPTIONS.map((option) => (
                          <option key={option.value} value={option.value}>
                            {option.label}
                          </option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label className="text-xs text-slate-300">
                        Size ({textStyles[key]?.fontSize || 28}px)
                      </label>
                      <input
                        type="range"
                        min={18}
                        max={80}
                        step={2}
                        value={textStyles[key]?.fontSize || 28}
                        onChange={(event) =>
                          setTextStyles((prev) => ({
                            ...prev,
                            [key]: { ...prev[key], fontSize: Number(event.target.value) },
                          }))
                        }
                        className="mt-3 w-full"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <Button onClick={composeImage} disabled={isBusy}>
              Compose branded image
            </Button>
            {composedUrl && (
              <img src={composedUrl} alt="Composed" className="w-full rounded-2xl border border-white/10" />
            )}
          </Card>
        </TabsContent>

        <TabsContent value="publish" className="space-y-6">
          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <h3 className="text-lg font-semibold flex items-center gap-2">
              <Rocket className="h-5 w-5" /> Campaign & Scheduling
            </h3>
            <div className="grid gap-6 md:grid-cols-2">
              <div className="space-y-3">
                <div>
                  <label className="text-xs uppercase tracking-widest text-slate-200">Assign campaign</label>
                  <select
                    value={campaignId}
                    onChange={(event) => setCampaignId(event.target.value)}
                    className="mt-2 w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"
                  >
                    <option value="">Select campaign</option>
                    {campaigns.map((campaign) => (
                      <option key={campaign.id} value={campaign.id}>
                        {campaign.name}
                      </option>
                    ))}
                  </select>
                </div>
                <Button
                  variant="secondary"
                  onClick={assignCampaign}
                  disabled={isBusy}
                >
                  Link post to campaign
                </Button>
                {activeCampaign && (
                  <p className="text-xs text-slate-200">
                    Active campaign: <span className="text-white">{activeCampaign.name}</span>
                  </p>
                )}
                <Separator className="bg-white/10" />
                <div className="space-y-2">
                  <p className="text-sm font-semibold text-slate-200">Create a campaign</p>
                  <Input
                    value={campaignForm.name}
                    onChange={(event) => setCampaignForm((prev) => ({ ...prev, name: event.target.value }))}
                    placeholder="Campaign name"
                    className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                  />
                  <Textarea
                    value={campaignForm.description}
                    onChange={(event) => setCampaignForm((prev) => ({ ...prev, description: event.target.value }))}
                    placeholder="Campaign description"
                    className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                  />
                  <div className="grid gap-2 md:grid-cols-2">
                    <Input
                      type="datetime-local"
                      value={campaignForm.starts_at}
                      onChange={(event) => setCampaignForm((prev) => ({ ...prev, starts_at: event.target.value }))}
                      className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                    />
                    <Input
                      type="datetime-local"
                      value={campaignForm.ends_at}
                      onChange={(event) => setCampaignForm((prev) => ({ ...prev, ends_at: event.target.value }))}
                      className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                    />
                  </div>
                  <Button
                    variant="secondary"
                    onClick={createCampaign}
                    disabled={isBusy}
                  >
                    Create campaign
                  </Button>
                </div>
              </div>

              <div className="space-y-3">
                <label className="text-xs uppercase tracking-widest text-slate-200">Schedule post</label>
                <Input
                  type="datetime-local"
                  value={scheduleAt}
                  onChange={(event) => setScheduleAt(event.target.value)}
                  className="bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                />
                <div className="flex gap-2">
                  <Button variant="secondary" onClick={saveSchedule} disabled={isBusy}>
                    Save schedule
                  </Button>
                  <Button
                    variant="secondary"
                    onClick={() => setScheduleAt('')}
                    disabled={isBusy}
                  >
                    Clear
                  </Button>
                </div>
                <p className="text-xs text-slate-200">
                  Scheduling saves a time on the post. Publishing automation can be wired later.
                </p>
              </div>
            </div>
            {batchRuns.length > 0 && (
              <div className="rounded-xl border border-white/10 bg-white/5 p-4 space-y-3">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm font-semibold text-slate-200">Batch schedule</p>
                    <p className="text-xs text-slate-200">Auto-schedule batch posts on a cadence.</p>
                  </div>
                  <Badge variant="secondary">{batchRuns.length} posts</Badge>
                </div>
                <div className="grid gap-3 md:grid-cols-2">
                  <div>
                    <label className="text-xs uppercase tracking-widest text-slate-200">Start date</label>
                    <Input
                      type="datetime-local"
                      value={batchScheduleStart}
                      onChange={(event) => setBatchScheduleStart(event.target.value)}
                      className="mt-2 bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                    />
                  </div>
                  <div>
                    <label className="text-xs uppercase tracking-widest text-slate-200">Cadence (days)</label>
                    <Input
                      type="number"
                      min={1}
                      value={batchScheduleIntervalDays}
                      onChange={(event) => setBatchScheduleIntervalDays(Number(event.target.value) || 1)}
                      className="mt-2 bg-white/5 border-white/10 text-white placeholder:text-slate-500"
                    />
                  </div>
                </div>
                <Button variant="secondary" onClick={scheduleBatchPosts} disabled={isBusy}>
                  Schedule batch
                </Button>
                {batchScheduleError && <p className="text-xs text-rose-300">{batchScheduleError}</p>}
                {batchScheduleSuccess && <p className="text-xs text-emerald-200">{batchScheduleSuccess}</p>}
                {batchSchedulePreview.length > 0 && (
                  <div className="grid gap-2 md:grid-cols-2">
                    {batchSchedulePreview.map((item) => (
                      <div key={item.id} className="rounded-lg border border-white/10 bg-white/5 p-2">
                        <p className="text-xs text-slate-200">{item.prompt}</p>
                        <p className="text-xs text-slate-200">{item.scheduledForLabel}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
            {campaignError && <p className="text-xs text-rose-300">{campaignError}</p>}
          </Card>

          <Card className="p-6 space-y-4 bg-[#0b1234]/70 border-white/10 text-white">
            <h3 className="text-lg font-semibold flex items-center gap-2">
              <ShieldCheck className="h-5 w-5" /> Compliance & Publishing
            </h3>
            {publishIssues.length > 0 ? (
              <div className="rounded-xl border border-rose-400/40 bg-rose-500/10 p-3 text-sm text-rose-100 space-y-1">
                <p className="font-semibold">Publishing checklist</p>
                {publishIssues.map((issue) => (
                  <p key={issue} className="text-xs text-rose-100/90">
                    - {issue}
                  </p>
                ))}
              </div>
            ) : (
              <Badge variant="secondary" className="w-fit">
                Ready to publish
              </Badge>
            )}
            <Button onClick={runCompliance} disabled={isBusy}>
              Run compliance checks
            </Button>
            {compliance && (
              <div className="space-y-3">
                <Badge variant="secondary" className="px-3 py-1">
                  Status: {compliance.status.toUpperCase()}
                </Badge>
                <div className="grid gap-3 md:grid-cols-2">
                  {compliance.checks.map((check, idx) => (
                    <Card key={idx} className="p-3 bg-white/5 border-white/10 text-sm text-slate-200">
                      <div className="flex items-center justify-between">
                        <span>{check.type}</span>
                        <Badge variant="secondary">{check.status}</Badge>
                      </div>
                    </Card>
                  ))}
                </div>
              </div>
            )}
            <Separator className="bg-white/10" />
            <div className="flex flex-col gap-3 md:flex-row">
              <Button onClick={() => publishPost(false)} disabled={isBusy} className="gap-2">
                <CheckCircle2 className="h-4 w-4" />
                Approve only
              </Button>
              <Button onClick={() => publishPost(true)} disabled={isBusy} className="gap-2" variant="secondary">
                <Rocket className="h-4 w-4" />
                Publish to LinkedIn
              </Button>
            </div>
            {publishError && <p className="text-xs text-rose-300">{publishError}</p>}
            <p className="text-xs text-slate-200">
              Publishing to LinkedIn requires a connected account and passes through manual approval safeguards.
            </p>
          </Card>
        </TabsContent>
      </Tabs>
    </div>
  );
}
