    setIsBusy(true);
    setBrandKitError(null);
    const res = await fetch('/api/pro/brand-kit/lock', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ brandKitId }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setBrandKitError(errorBody.error || 'Failed to lock brand kit.');
      return;
    }
    const data = await res.json();
    setBrandKits((prev) => prev.map((kit) => (kit.id === data.brand_kit.id ? data.brand_kit : kit)));
  };

  const suggestBrandKit = async () => {
    if (!brandId) {
      setBrandKitError('Select a brand before requesting a suggestion.');
      return;
    }
    setIsBusy(true);
    setBrandKitError(null);
    const res = await fetch('/api/pro/brand-kit/suggest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ brandId }),
    });
    setIsBusy(false);
    if (!res.ok) {
      const errorBody = await res.json().catch(() => ({}));
      setBrandKitError(errorBody.error || 'Failed to suggest brand kit.');
